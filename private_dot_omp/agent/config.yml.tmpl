# Managed by chezmoi. Deployed to ~/.omp/agent/config.yml.
# Keep secrets in the local auth database or environment, not in this file.
# Only non-default values are listed (verified against omp 16.3.15 schema).

advisor:
  enabled: false
  syncBacklog: "3"
autolearn:
  enabled: true
  autoContinue: true
bash:
  autoBackground:
    enabled: true
browser:
  cmux: false
commands:
  enableOpencodeUser: false
  enableOpencodeProject: false
compaction:
  handoffSaveToDisk: true
  idleEnabled: true # run maintenance while idle
  reserveTokens: 16384 # headroom kept under the context window
  strategy: snapcompact # "context-full" | "handoff" | "shake" | "snapcompact" | "off"
defaultThinkingLevel: auto
dev:
  autoqa:
    consent: granted
display:
  shimmer: kitt
  showTokenUsage: true
exa:
  enableSearch: false
  enabled: false
extensions:
  - "{{ .chezmoi.homeDir }}/.omp/agent/plugins/local-dotfiles-tools/hooks/mise-just-enforcer.ts"
features:
  unexpectedStopDetection: true
inspect_image:
  enabled: true
lsp:
  formatOnWrite: true
mcp:
  discoveryMode: true
memory:
  backend: hindsight
mnemopi:
  # inactive while memory.backend is hindsight; kept for a possible backend switch
  embeddingVariant: multilingual
  scoping: per-project-tagged
{{- if eq .machine_type "client" }}
defaultModel: litellm/gpt-5.6-sol:high
modelProviderOrder:
  - litellm
modelRoles:
  default: litellm/gpt-5-6-terra
  advisor: litellm/gpt-5-6-terra
  plan:    litellm/gpt-5-6-sol
  smol:    litellm/gpt-5-6-luna
  slow:    litellm/gpt-5-6-sol:high
  task:    litellm/gpt-5-6-terra
  commit:  openai-codex/gpt-5-6-luna
{{- else }}
modelRoles:
  default: openai-codex/gpt-5.6-terra:high
  plan:    openai-codex/gpt-5.6-sol
  smol:    openai-codex/gpt-5.6-luna
  slow:    openai-codex/gpt-5.6-sol:high
  task:    litellm/gpt-5.6-terra
  commit:  openai-codex/gpt-5.6-luna
{{- end }}
personality: pragmatic
providers:
  webSearch: searxng
read:
  summarize:
    prose: true
readLineNumbers: true
searxng:
  endpoint: http://localhost:3939/
setupVersion: 1
statusLine:
  preset: nerd
  transparent: true
symbolPreset: nerd
task:
  showResolvedModelBadge: true
  isolation:
    mode: auto
    merge: branch
    commits: ai
terminal:
  showProgress: true
theme:
  dark: dracula
  light: light-cyberpunk
worktree:
  base: .git/wt
# Native `omp` MCP support reads ~/.omp/agent/mcp.json.
# Pi-specific packages remain configured separately under ~/.pi during the parallel rollout.
