# Managed by chezmoi. Deployed to ~/.omp/agent/config.yml.
# Keep secrets in the local auth database or environment, not in this file.

theme:
  dark: dracula
  light: light-cyberpunk
thinkingLevel: low
enableInstallTelemetry: false

terminal:
  showTerminalProgress: true
  showImages: true

extensions:
  - ./plugins/local-dotfiles-tools

{{- if eq .machine_type "client" }}
defaultModel: litellm/gpt-5-5:low
modelRoles:
  default: litellm/gpt-5-5:low
  smol: litellm/claude-haiku-4-5:low
  slow: litellm/claude-opus-4-8:high
  plan: litellm/claude-opus-4-8:medium
  task: litellm/claude-sonnet-4-6:low
modelProviderOrder:
  - litellm
{{- else }}
modelRoles:
  default: openai-codex/gpt-5.5:xhigh
  smol: pi/smol:low
  plan: pi/plan:low
{{- end }}

web_search:
  provider: searxng

exa:
  enabled: false
  enableSearch: false
  enableResearcher: false
  enableWebsets: false

searxng:
  endpoint: http://localhost:3939/

setupVersion: 1
symbolPreset: nerd
colorBlindMode: false
statusLine:
  preset: nerd
  separator: powerline-thin
  sessionAccent: true
  showHookStatus: true
images:
  autoResize: true
  blockImages: false
tui:
  hyperlinks: auto
display:
  shimmer: kitt
  showTokenUsage: true
showHardwareCursor: true
clearOnShrink: false
task:
  showResolvedModelBadge: false

lastChangelogVersion: 15.7.6
# Native `omp` MCP support reads ~/.omp/agent/mcp.json.
# Pi-specific packages remain configured separately under ~/.pi during the parallel rollout.
