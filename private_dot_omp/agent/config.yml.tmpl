# Managed by chezmoi. Deployed to ~/.omp/agent/config.yml.
# Keep secrets in the local auth database or environment, not in this file.
# Only non-default values are listed (verified against omp 16.3.15 schema).

advisor: 
  enabled: true
  syncBacklog: "3"
autolearn: 
  enabled: true
  autoContinue: true
bash: 
  autoBackground: 
    enabled: true
browser: 
  enabled: true
  cmux: false
commands: 
  enableOpencodeUser: false
  enableOpencodeProject: false
compaction: 
  handoffSaveToDisk: true
  idleEnabled: true # run maintenance while idle
  idleThresholdTokens: 150000 # compact substantial context during idle periods
  idleTimeoutSeconds: 120 # avoid retaining costly context through short pauses
  reserveTokens: 16384 # headroom kept under the context window
  keepRecentTokens: 20000 # retain the latest working set after compaction
  midTurnEnabled: true # compact at safe boundaries in long tool loops
  strategy: snapcompact # "context-full" | "handoff" | "shake" | "snapcompact" | "off"
  thresholdTokens: 180000 # compact before uncached history dominates prompt cost
defaultThinkingLevel: auto
dev: 
  autoqaConsent: granted
display: 
  shimmer: kitt
  showTokenUsage: true
exa: 
  enableSearch: false
  enabled: false
extensions: 
  - "{{ .chezmoi.homeDir }}/.omp/agent/plugins/local-dotfiles-tools/hooks/mise-just-enforcer.ts"
features: 
  unexpectedStopDetection: true
inspect_image: 
  mode: "on"
lsp: 
  formatOnWrite: true
mcp: 
  {}
memory: 
  backend: hindsight
mnemopi: 
  # inactive while memory.backend is hindsight; kept for a possible backend switch
  embeddingVariant: multilingual
  scoping: per-project-tagged
{{- if eq .machine_type "client" }}
defaultModel: litellm/gpt-5.6-sol:high
modelProviderOrder: 
  - litellm
modelRoles: 
  default: litellm/gpt-5-6-sol
  advisor: litellm/gpt-5-6-terra
  plan: litellm/gpt-5-6-sol
  smol: litellm/gpt-5-6-luna
  slow: litellm/gpt-5-6-sol:high
  task: litellm/gpt-5-6-terra
  commit: openai-codex/gpt-5-6-luna
{{- else }}
modelRoles:
  default: openai-codex/gpt-5.6-sol:medium
  plan:    openai-codex/gpt-5.6-sol
  smol:    openai-codex/gpt-5.6-luna
  slow:    openai-codex/gpt-5.6-terra:high
  task:    openai-codex/gpt-5.6-terra
  commit:  openai-codex/gpt-5.6-luna
{{- end }}
personality: pragmatic
providers: 
  webSearchOrder: 
    - searxng
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
read: 
  summarize: 
    prose: true
readLineNumbers: true
searxng: 
  endpoint: http://localhost:3939/
setupVersion: 1
statusLine: 
  preset: nerd
  transparent: true
symbolPreset: nerd
task: 
  showResolvedModelBadge: true
  isolation: 
    mode: auto
    merge: branch
    commits: ai
terminal: 
  showProgress: true
theme: 
  dark: dracula
  light: light-cyberpunk
worktree: 
  base: .git/wt
stt: 
  modelName: parakeet
  enabled: true
power: 
  sleepPrevention: idle
shellMinimizer: 
  sourceOutlineLevel: aggressive
speechgen: 
  enabled: false
ask: 
  enabled: true
web_search: 
  enabled: true
todo: 
  eager: default
secrets: 
  enabled: true