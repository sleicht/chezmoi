# Managed by chezmoi. Deployed to ~/.omp/agent/models.yml.
# Credentials are intentionally not committed. For LiteLLM, set LITELLM_BASE_URL
# and LITELLM_API_KEY locally, or authenticate through `omp` so credentials live
# in ~/.omp/agent/agent.db.

{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
providers:
  litellm:
    name: LiteLLM
    baseUrl: {{ $cc.litellm_url.value }}
    apiKey: LITELLM_API_KEY
    api: openai-completions
    compat:
      supportsDeveloperRole: false
      supportsReasoningEffort: false
      supportsStore: false
    models:
      - id: claude-haiku-4-5
        name: Claude Haiku 4.5 via LiteLLM
        reasoning: true
        input:
          - text
          - image
        cost:
          input: 1
          output: 5
          cacheRead: 0.1
          cacheWrite: 1.25
        contextWindow: 200000
        maxTokens: 8192
        compat:
          supportsStore: false
          cacheControlFormat: anthropic
      - id: claude-sonnet-4-6
        name: Claude Sonnet 4.6 via LiteLLM
        reasoning: true
        input:
          - text
          - image
        cost:
          input: 3
          output: 15
          cacheRead: 0.3
          cacheWrite: 3.75
        contextWindow: 1000000
        maxTokens: 64000
        compat:
          supportsStore: false
          cacheControlFormat: anthropic
      - id: claude-opus-4-6
        name: Claude Opus 4.6 via LiteLLM
        reasoning: true
        input:
          - text
          - image
        cost:
          input: 5
          output: 25
          cacheRead: 0.5
          cacheWrite: 6.25
        contextWindow: 1000000
        maxTokens: 128000
        compat:
          supportsStore: false
          cacheControlFormat: anthropic
      - id: claude-opus-4-8
        name: Claude Opus 4.8 via LiteLLM
        reasoning: true
        input:
          - text
          - image
        cost:
          input: 5
          output: 25
          cacheRead: 1.5
          cacheWrite: 6.25
        contextWindow: 200000
        maxTokens: 32000
        compat:
          supportsStore: false
          cacheControlFormat: anthropic
      - id: claude-opus-4-7
        name: Claude Opus 4.7 via LiteLLM
        reasoning: true
        input:
          - text
          - image
        cost:
          input: 5
          output: 25
          cacheRead: 0.5
          cacheWrite: 6.25
        contextWindow: 1000000
        maxTokens: 128000
        compat:
          supportsStore: false
          cacheControlFormat: anthropic
      - id: gemini-3.1-flash-lite
        name: Gemini 3.1 Flash Lite via LiteLLM
        reasoning: false
        input:
          - text
        cost:
          input: 0.275
          output: 1.65
          cacheRead: 0
          cacheWrite: 0
        contextWindow: 128000
        maxTokens: 16384
        compat:
          supportsStore: false
      - id: gemini-3.5-flash
        name: Gemini 3.5 Flash via LiteLLM
        reasoning: false
        input:
          - text
        cost:
          input: 1.65
          output: 9.9
          cacheRead: 0
          cacheWrite: 0
        contextWindow: 128000
        maxTokens: 16384
        compat:
          supportsStore: false
      - id: gpt-5-5
        name: GPT-5.5 via LiteLLM
        reasoning: true
        input:
          - text
        cost:
          input: 5.5
          output: 33
          cacheRead: 0
          cacheWrite: 0
        contextWindow: 128000
        maxTokens: 16384
        compat:
          supportsStore: false
{{- else }}
# Personal machines currently rely on `omp` built-in providers and local auth.
providers: {}
{{- end }}