"$schema" = "https://forgecode.dev/schema.json"

# ForgeCode configuration
# Managed by chezmoi — edit the source, not ~/.forge/.forge.toml
#
# Comments note deviations from built-in defaults where known.
# Schema reference: https://forgecode.dev/schema.json

# ── Limits ───────────────────────────────────────────────────────────
max_search_lines = 1000
max_search_result_bytes = 10240
max_fetch_chars = 50000
max_stdout_prefix_lines = 100
max_stdout_suffix_lines = 100
max_stdout_line_chars = 500
max_line_chars = 2000
max_read_lines = 2000
max_file_read_batch_size = 50
max_file_size_bytes = 104857600     # 100 MiB
max_image_size_bytes = 262144       # 256 KiB
max_parallel_file_reads = 64
max_extensions = 15
max_conversations = 100

# ── Search ───────────────────────────────────────────────────────────
max_sem_search_results = 100
sem_search_top_k = 10
services_url = "https://api.forgecode.dev/"

# ── Model sampling ──────────────────────────────────────────────────
# Deviation: tuned for less random output (defaults unset / provider)
top_p = 0.8
top_k = 30
# Deviation: raised from default for complex multi-tool responses
max_tokens = 20480

# ── Tool execution ──────────────────────────────────────────────────
tool_timeout_secs = 300
tool_supported = true
max_tool_failure_per_turn = 3
max_requests_per_turn = 100

# ── Permissions ─────────────────────────────────────────────────────
# Deviation: true activates ~/.forge/permissions.yaml policy evaluation
# (default: false — all tools run without restriction)
restricted = true

# ── Features ────────────────────────────────────────────────────────
auto_open_dump = false
# Deviation: enabled (default: false) — reminds LLM of pending todos
verify_todos = true
# Deviation: enabled (default: false) — forge/muse subagent delegation
subagents = true
research_subagent = false
# Deviation: enabled (default: false) — Switches patch replacement fallback from the legacy fuzzy-search range lookup to the newer text-patch gRPC API
use_text_patch_fallback = true

# ── Commit ──────────────────────────────────────────────────────────
use_forge_committer = true
max_commit_count = 20

# ── Display ─────────────────────────────────────────────────────────
currency_symbol = ""
currency_conversion_rate = 0.0
model_cache_ttl_secs = 604800      # 7 days

# ── Session (provider + model) ──────────────────────────────────────
[session]
{{- if eq .machine_type "client" }}
provider_id = "vertex_ai_anthropic"
{{- else }}
provider_id = "anthropic"
{{- end }}
model_id = "claude-opus-4-6"

# ── Suggest ─────────────────────────────────────────────────────────
[suggest]
{{- if eq .machine_type "client" }}
provider_id = "vertex_ai_anthropic"
{{- else }}
provider_id = "anthropic"
{{- end }}
model_id = "claude-sonnet-4-6"

# ── Retry ───────────────────────────────────────────────────────────
[retry]
initial_backoff_ms = 200
min_delay_ms = 1000
backoff_factor = 2
max_attempts = 8
status_codes = [429, 500, 502, 503, 504, 408, 522, 524, 520, 529]
suppress_errors = false

# ── HTTP ────────────────────────────────────────────────────────────
[http]
connect_timeout_secs = 30
read_timeout_secs = 900
pool_idle_timeout_secs = 90
pool_max_idle_per_host = 5
max_redirects = 10
hickory = false
tls_backend = "default"
adaptive_window = true
keep_alive_interval_secs = 60
keep_alive_timeout_secs = 10
keep_alive_while_idle = true
accept_invalid_certs = false

# ── Updates ─────────────────────────────────────────────────────────
[updates]
frequency = "daily"
auto_update = true

# ── Compaction ──────────────────────────────────────────────────────
[compact]
retention_window = 6
eviction_window = 0.2
max_tokens = 2000
token_threshold = 100000
message_threshold = 200
on_turn_end = false

# ── Reasoning ───────────────────────────────────────────────────────
# Deviation: high effort (default: medium)
[reasoning]
effort = "high"
enabled = true
