#!/bin/sh
# Shared workspace guard; GitButler lifecycle hooks belong to individual repos.

HOOKS_DIR=$(dirname "$0")
if [ -x "$HOOKS_DIR/pre-commit-user" ]; then
    "$HOOKS_DIR/pre-commit-user" "$@" || exit $?
fi

if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "gitbutler/workspace" ]; then
    echo "Cannot commit directly to gitbutler/workspace; use but commit." >&2
    exit 1
fi

exit 0
