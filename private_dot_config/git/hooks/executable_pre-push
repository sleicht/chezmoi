#!/bin/bash
# Global pre-push hook — blocks pushes containing detected secrets
# Deployed by chezmoi to ~/.config/git/hooks/pre-push

# Delegate to repo-local hook if it exists
repo_hooks="$(git rev-parse --git-common-dir)/hooks"
if [[ -x "$repo_hooks/pre-push" && ! "$repo_hooks/pre-push" -ef "$0" ]]; then
  exec "$repo_hooks/pre-push" "$@"
fi

# Skip if gitleaks is not installed
if ! command -v gitleaks &> /dev/null; then
  exit 0
fi

# Preserve ref updates for the delegated hook after scanning outgoing history.
updates=$(</dev/stdin)
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "$local_ref" && -n "$remote_ref" ]] || continue
  [[ "$local_sha" =~ ^0+$ ]] && continue # Deleted ref

  log_opts="$local_sha"
  if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    log_opts="${remote_sha}..${local_sha}"
  fi

  if ! gitleaks git --log-opts="$log_opts" --redact --verbose; then
    echo "BLOCKED: Secret scan failed for $local_ref. Push aborted." >&2
    exit 1
  fi
done <<< "$updates"

# Delegate to sonarqube-cli hook if it exists
if [[ -x .sonar/sonarqube-cli/hooks/pre-push ]]; then
  exec .sonar/sonarqube-cli/hooks/pre-push "$@" <<< "$updates"
fi

exit 0
