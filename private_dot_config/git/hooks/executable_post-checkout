#!/bin/bash
# Global post-checkout hook — light secret scanning for all repos
# Deployed by chezmoi to ~/.config/git/hooks/post-checkout

# Delegate to repo-local hook if it exists (e.g., post-checkout framework)
repo_hooks="$(git rev-parse --git-common-dir)/hooks"
if [[ -x "$repo_hooks/post-checkout" && ! "$repo_hooks/post-checkout" -ef "$0" && ! "$repo_hooks/post-checkout" -ef "$(dirname "$0")/post-checkout" ]]; then
  exec "$repo_hooks/post-checkout" "$@"
    fi


# Delegate to sonarqube-cli hook if it exists
if [[ -x .sonar/sonarqube-cli/hooks/post-checkout ]]; then
  exec .sonar/sonarqube-cli/hooks/post-checkout "$@"
fi

# Delegate to post-checkout hook if it exists
if [[ -x .~/.post-checkout-cache/git-init-template/hooks/post-checkout ]]; then
  exec ~/.post-checkout-cache/git-init-template/hooks/post-checkout "$@"
fi

# Warn only on commit (exit 0 regardless) — per user decision
exit 0
