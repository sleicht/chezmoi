# Hyprspace starter config with local monitor and menu-bar integration.
# Hyprspace supplies the opinionated dwindle defaults; keep this file small.

config-version = 2
start-at-login = true

# Route already-open windows when Hyprspace starts.
after-startup-command = ['''exec-and-forget bash -c '
  tile_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" h_tiles; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  accordion_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" accordion; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  resize_width() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace resize --window-id "$wid" width "$2"; done
  }
  float_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" floating; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  float_move com.apple.finder 0
  float_move com.cocoatech.PathFinder 0
  float_move io.tailscale.ipn.macos 0
  tile_move com.mitchellh.ghostty 1
  tile_move com.cmuxterm.app 1
  tile_move com.t3tools.t3code 1
  tile_move com.gitbutler.app 1
  accordion_move com.jetbrains.intellij 2
  accordion_move com.sublimetext.4 2
  float_move com.google.Chrome 3
  float_move app.zen-browser.zen 3
  float_move com.vivaldi.Vivaldi 3
  float_move company.thebrowser.Browser 3
  tile_move com.readdle.SparkDesktop 4
  tile_move com.flexibits.fantastical2.mac 4
  tile_move com.microsoft.Outlook 4
  resize_width com.readdle.SparkDesktop 1400
  tile_move net.whatsapp.WhatsApp 5
  tile_move ch.threema.threema-desktop 5
  tile_move com.infomaniak.chat 5
  tile_move com.apple.MobileSMS 5
  tile_move com.tinyspeck.slackmacgap 5
  tile_move com.microsoft.teams2 5
'
''',
  'exec-and-forget borders active_color=0xff50bfcb inactive_color=0xff414550 width=8.0 hidpi=off',
]

# Keep routed file-manager and external-monitor workspaces available.
persistent-workspaces = ["0", "7"]

# Notify Sketchybar about workspace changes.
exec-on-workspace-change = [
  '/bin/bash',
  '-lc',
  'sketchybar --trigger hyprspace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE PREV_WORKSPACE=$AEROSPACE_PREV_WORKSPACE',
]

# Keep the main starter workspaces on the primary monitor and workspace 7 on
# the small external monitor.
[workspace-to-monitor-force-assignment]
{{- $m := .monitors.personal -}}
{{- if eq .machine_type "client" }}
{{- $m = .monitors.client -}}
{{- end }}
1 = '{{ $m.primary }}'
2 = '{{ $m.primary }}'
3 = '{{ $m.primary }}'
4 = '{{ $m.primary }}'
5 = '{{ $m.primary }}'
6 = '{{ $m.primary }}'
7 = '{{ $m.secondary }}'

[gaps]
inner.horizontal = 18
inner.vertical = 18
outer.left = 18
outer.right = 18
outer.bottom = 18
outer.top = [{ monitor."built-in" = 18 }, { monitor."main" = 48 }, 48]

# ---------- MAIN KEY BINDINGS -----------
[mode.main.binding]
alt-0 = 'workspace 0'
alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'
alt-5 = 'workspace 5'
alt-6 = 'workspace 6'
alt-7 = 'workspace 7'
alt-shift-0 = 'move-node-to-workspace 0'
alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'

alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'
alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

alt-tab = 'focus-back-and-forth'
alt-shift-space = [
  'layout floating tiling',
  'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"',
]
alt-shift-semicolon = 'mode service'
alt-shift-slash = [
  'layout tiles horizontal vertical',
  'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"',
]
alt-shift-comma = [
  'layout accordion horizontal vertical',
  'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"',
]
alt-minus = 'resize smart -50'
alt-equal = 'resize smart +50'
alt-f = [
  'fullscreen',
  'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"',
]
alt-cmd-f = 'macos-native-fullscreen'

# ---------- SERVICE MODE -----------
[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
f = [
  'layout floating tiling',
  'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"',
  'mode main',
]
alt-shift-semicolon = 'mode main'

# ---------- WINDOW CONTROL -----------
[[on-window-detected]]
if.app-id = "com.apple.ScreenSharing"
run = ["layout floating"]

[[on-window-detected]]
if.app-id = 'com.apple.iphonesimulator'
run = ["layout floating"]

[[on-window-detected]]
if.app-id = 'com.macpaw.CleanMyMac'
run = ["layout floating"]

[[on-window-detected]]
if.app-id = "com.macpaw.CleanMyMac4"
run = ["layout floating"]

[[on-window-detected]]
