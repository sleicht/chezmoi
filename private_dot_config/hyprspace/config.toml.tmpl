# Pop!_OS COSMIC-style key bindings for Hyprspace
# 'ctrl' (⌃) = Linux Super/Windows key equivalent
# Reference: https://support.system76.com/articles/pop-cosmic-keyboard-shortcuts/

config-version = 2

after-login-command = []

# Move already-open windows to their workspaces on startup
after-startup-command = ['''exec-and-forget bash -c '
  tile_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" h_tiles; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  accordion_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" accordion; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  resize_width() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace resize --window-id "$wid" width "$2"; done
  }
  float_move() {
    hyprspace list-windows --monitor all --app-bundle-id "$1" --format "%{window-id}" 2>/dev/null \
      | while read -r wid; do hyprspace layout --window-id "$wid" floating; hyprspace move-node-to-workspace --window-id "$wid" "$2"; done
  }
  float_move com.apple.finder 0
  float_move com.cocoatech.PathFinder 0
  float_move io.tailscale.ipn.macos 0
  tile_move com.mitchellh.ghostty 1
  tile_move com.cmuxterm.app 1
  tile_move com.t3tools.t3code 1
  tile_move com.gitbutler.app 1
  accordion_move com.jetbrains.intellij 2
  accordion_move com.sublimetext.4 2
  float_move com.google.Chrome 3
  float_move app.zen-browser.zen 3
  float_move com.vivaldi.Vivaldi 3
  float_move company.thebrowser.Browser 3
  tile_move com.readdle.SparkDesktop 4
  tile_move com.flexibits.fantastical2.mac 4
  tile_move com.microsoft.Outlook 4
  resize_width com.readdle.SparkDesktop 1400
  tile_move net.whatsapp.WhatsApp 5
  tile_move ch.threema.threema-desktop 5
  tile_move com.infomaniak.chat 5
  tile_move com.apple.MobileSMS 5
  tile_move com.tinyspeck.slackmacgap 5
  tile_move com.microsoft.teams2 5
'
''']

# Start Hyprspace at login
start-at-login = true

# Keep workspace 0 always available; 7 is the small external monitor workspace
persistent-workspaces = ["0", "7"]

# Normalizations keep the tree sane — Cosmic also uses a tree-based tiling model
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# Mouse follows focus when focused monitor changes
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

# Prevent macOS from hiding apps (cmd is our Super key, so cmd-h conflicts)
automatically-unhide-macos-hidden-apps = false

# Notify Sketchybar about workspace change
exec-on-workspace-change = [
  '/bin/bash',
  '-c',
  'sketchybar --trigger hyprspace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE PREV_WORKSPACE=$AEROSPACE_PREV_WORKSPACE',
]

# Pin workspace 7 to external monitor
[workspace-to-monitor-force-assignment]
{{- $m := .monitors.personal -}}
{{- if eq .machine_type "client" }}
{{- $m = .monitors.client -}}
{{- end }}
1 = '{{ $m.primary }}'
2 = '{{ $m.primary }}'
3 = '{{ $m.primary }}'
4 = '{{ $m.primary }}'
5 = '{{ $m.primary }}'
6 = '{{ $m.primary }}'
7 = '{{ $m.secondary }}'

[key-mapping]
preset = 'qwerty'

# ── Gaps ──────────────────────────────────────────────────────────────────────
# Cosmic Desktop has gaps between tiled windows by default
[gaps]
inner.horizontal = 3
inner.vertical = 3
outer.left = 5
outer.bottom = 5
outer.top = [{ monitor."DELL U2725QE" = 20 }, 5]
outer.right = 5

# ── Main Bindings ─────────────────────────────────────────────────────────────
[mode.main.binding]

# ── Navigation ────────────────────────────────────────────────────────────────

# Ctrl + Arrow keys → Focus window in direction
ctrl-left  = 'focus left'
ctrl-down  = 'focus down'
ctrl-up    = 'focus up'
ctrl-right = 'focus right'

# Ctrl + Shift + Arrow keys → Navigate between workspaces
ctrl-shift-up    = 'workspace prev'
ctrl-shift-down  = 'workspace next'
ctrl-shift-left  = 'workspace prev'
ctrl-shift-right = 'workspace next'


# ── Move Windows ──────────────────────────────────────────────────────────────

# Ctrl + Shift + Arrow keys are used for workspace nav, so use Ctrl + Alt for moving
# Ctrl + Alt + Arrow keys → Move window in tiling layout
ctrl-alt-left  = 'move left'
ctrl-alt-right = 'move down'
ctrl-alt-up    = 'move up'
ctrl-alt-down  = 'move right'

# Ctrl + Alt + Shift + Arrow keys → Move window to next/prev monitor
ctrl-alt-shift-left  = 'move-node-to-monitor --wrap-around prev'
ctrl-alt-shift-right = 'move-node-to-monitor --wrap-around next'

# Ctrl + Alt + Shift + Up/Down → Move window to prev/next workspace
ctrl-alt-shift-up    = 'move-node-to-workspace prev --focus-follows-window'
ctrl-alt-shift-down  = 'move-node-to-workspace next --focus-follows-window'

# Ctrl + Shift + number → Move window to workspace
ctrl-shift-0 = 'move-node-to-workspace 0 --focus-follows-window'
ctrl-shift-1 = 'move-node-to-workspace 1 --focus-follows-window'
ctrl-shift-2 = 'move-node-to-workspace 2 --focus-follows-window'
ctrl-shift-3 = 'move-node-to-workspace 3 --focus-follows-window'
ctrl-shift-4 = 'move-node-to-workspace 4 --focus-follows-window'
ctrl-shift-5 = 'move-node-to-workspace 5 --focus-follows-window'
ctrl-shift-6 = 'move-node-to-workspace 6 --focus-follows-window'
ctrl-shift-7 = 'move-node-to-workspace 7 --focus-follows-window'

# ── Manage Windows ────────────────────────────────────────────────────────────

# Ctrl + Q → Close window
ctrl-q = 'close'

# Ctrl + F → Maximize/fullscreen toggle
ctrl-f = ['fullscreen', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"']

# Ctrl + F11 → Fullscreen (alternate)
ctrl-f11 = ['fullscreen', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"']

# Ctrl + Enter → Launch terminal
ctrl-enter = '''exec-and-forget osascript -e '
tell application "Ghostty"
    activate
end tell'
'''

# Ctrl + R → Enter resize mode
ctrl-alt-r = 'mode resize'

# Ctrl + Shift + F → Toggle floating/tiling
ctrl-alt-f = ['layout floating tiling', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"']

# Ctrl + O → Flip tile orientation (horizontal ↔ vertical)
ctrl-alt-o = ['layout tiles horizontal vertical', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"']

# Ctrl + Alt + S → Toggle stacking (accordion)
ctrl-alt-s = ['layout accordion tiling', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"']

# ── Workspace / Monitor ──────────────────────────────────────────────────────

# Alt + Tab → Back and forth between last workspaces
alt-tab = 'workspace-back-and-forth'

# Alt + Shift + Tab → Move workspace to next monitor
alt-shift-tab = [
  'move-workspace-to-monitor --wrap-around next',
  'exec-and-forget sketchybar --trigger hyprspace_monitor_change TARGET_MONITOR=$(hyprspace list-monitors --focused --format "%{monitor-appkit-nsscreen-screens-id}") FOCUSED_WORKSPACE=$(hyprspace list-workspaces --focused)',
]

# ── Service / Config Reload ──────────────────────────────────────────────────
alt-shift-semicolon = 'mode service'
alt-shift-c = 'reload-config'

# ── Resize Mode ──────────────────────────────────────────────────────────────
[mode.resize.binding]
esc   = 'mode main'
enter = 'mode main'

right       = 'resize width +50'
shift-right = 'resize width -50'
left        = 'resize width -50'
shift-left  = 'resize width +50'
down        = 'resize height +50'
shift-down  = 'resize height -50'
up          = 'resize height -50'
shift-up    = 'resize height +50'

# ── Service Mode ─────────────────────────────────────────────────────────────
[mode.service.binding]
esc       = ['reload-config', 'mode main']
r         = ['flatten-workspace-tree', 'mode main'] # reset layout
f         = ['layout floating tiling', 'exec-and-forget $HOME/.local/bin/hyprspace-hud "$(hyprspace list-windows --focused --format "%{window-layout}")"', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']

# ── Window Detection Rules ───────────────────────────────────────────────────
# Default: all new windows float (override per-app below)
[[on-window-detected]]
check-further-callbacks = true
run = 'layout floating'

[[on-window-detected]]
if.app-id = 'com.apple.finder'
check-further-callbacks = false
run = ['layout floating', 'move-node-to-workspace 0'] # Floating on workspace 0

[[on-window-detected]]
if.app-id = 'com.cocoatech.PathFinder'
check-further-callbacks = false
run = ['layout floating', 'move-node-to-workspace 0'] # Floating on workspace 0

[[on-window-detected]]
if.app-id = 'io.tailscale.ipn.macos'
check-further-callbacks = false
run = ['layout floating', 'move-node-to-workspace 0'] # Floating on workspace 0

[[on-window-detected]]
if.app-id = 'com.mitchellh.ghostty'
check-further-callbacks = false
run = ['layout h_tiles', 'move-node-to-workspace 1'] # Terminal

[[on-window-detected]]
if.app-id = 'com.t3tools.t3code'
run = ['layout h_tiles', 'move-node-to-workspace 1'] # Terminal

[[on-window-detected]]
if.app-id = 'com.gitbutler.app'
run = ['layout h_tiles', 'move-node-to-workspace 1'] # Terminal

[[on-window-detected]]
if.app-id = 'com.cmuxterm.app'
run = ['layout h_tiles', 'move-node-to-workspace 1'] # Terminal

[[on-window-detected]]
if.app-id = 'com.jetbrains.intellij'
run = ['layout accordion', 'move-node-to-workspace 2'] # IDE

[[on-window-detected]]
if.app-id = 'com.sublimetext.4'
check-further-callbacks = false
run = ['layout accordion', 'move-node-to-workspace 2'] # IDE

[[on-window-detected]]
if.app-id = 'com.google.Chrome'
run = ['layout floating', 'move-node-to-workspace 3'] # Web

[[on-window-detected]]
if.app-id = 'app.zen-browser.zen'
run = ['layout floating', 'move-node-to-workspace 3'] # Web

[[on-window-detected]]
if.app-id = 'com.vivaldi.Vivaldi'
run = ['layout floating', 'move-node-to-workspace 3'] # Web

[[on-window-detected]]
if.app-id = 'company.thebrowser.Browser'
run = ['layout floating', 'move-node-to-workspace 3'] # Web

[[on-window-detected]]
if.app-id = 'com.readdle.SparkDesktop'
run = ['layout h_tiles', 'move-node-to-workspace 4', 'resize width 1400'] # Mail

[[on-window-detected]]
if.app-id = 'com.flexibits.fantastical2.mac'
run = ['layout h_tiles', 'move-node-to-workspace 4'] # Calendar

[[on-window-detected]]
if.app-id = 'com.microsoft.Outlook'
run = ['layout h_tiles', 'move-node-to-workspace 4'] # Mail

[[on-window-detected]]
if.app-id = 'net.whatsapp.WhatsApp'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social

[[on-window-detected]]
if.app-id = 'ch.threema.threema-desktop'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social

[[on-window-detected]]
if.app-id = 'com.infomaniak.chat'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social

[[on-window-detected]]
if.app-id = 'com.apple.MobileSMS'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social

[[on-window-detected]]
if.app-id = 'com.tinyspeck.slackmacgap'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social

[[on-window-detected]]
if.app-id = 'com.microsoft.teams2'
run = ['layout h_tiles', 'move-node-to-workspace 5'] # Social
