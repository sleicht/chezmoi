# ~/.config/skhd/skhdrc
# Pop!_OS COSMIC-ish keybindings ported from your AeroSpace config
# ctrl = Linux Super/Windows muscle memory

# -----------------------------
# Focus windows
# -----------------------------
ctrl - left  : yabai -m window --focus west
ctrl - down  : yabai -m window --focus south
ctrl - up    : yabai -m window --focus north
ctrl - right : yabai -m window --focus east

# -----------------------------
# Navigate spaces
# -----------------------------
ctrl + shift - left  : yabai -m space --focus prev
ctrl + shift - right : yabai -m space --focus next
ctrl + shift - up    : yabai -m space --focus prev
ctrl + shift - down  : yabai -m space --focus next
alt - tab            : yabai -m space --focus recent

# Direct space focus
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7

# -----------------------------
# Move / warp windows in layout
# -----------------------------
ctrl + alt - left  : yabai -m window --warp west
ctrl + alt - down  : yabai -m window --warp south
ctrl + alt - up    : yabai -m window --warp north
ctrl + alt - right : yabai -m window --warp east

# Move window to display
ctrl + alt + shift - left  : yabai -m window --display prev; yabai -m display --focus prev
ctrl + alt + shift - right : yabai -m window --display next; yabai -m display --focus next

# Move window to prev/next space
ctrl + alt + shift - up   : yabai -m window --space prev; yabai -m space --focus prev
ctrl + alt + shift - down : yabai -m window --space next; yabai -m space --focus next

# Move window to numbered space
ctrl + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
ctrl + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
ctrl + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
ctrl + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
ctrl + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
ctrl + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
ctrl + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7

# -----------------------------
# Manage focused window
# -----------------------------
ctrl - q       : yabai -m window --close
ctrl - f       : yabai -m window --toggle zoom-fullscreen
ctrl - f11     : yabai -m window --toggle native-fullscreen
ctrl + alt - f : yabai -m window --toggle float
ctrl + alt - o : yabai -m space --rotate 90
ctrl + alt - s : yabai -m space --layout stack
ctrl + alt - b : yabai -m space --balance

# Launch terminal
ctrl - return : open -a Ghostty

# -----------------------------
# Resize mode
# -----------------------------
:: resize
ctrl + alt - r ; resize
resize < escape : default
resize < return : default
resize < right       : yabai -m window --resize right:50:0
resize < shift - right : yabai -m window --resize right:-50:0
resize < left        : yabai -m window --resize left:-50:0
resize < shift - left  : yabai -m window --resize left:50:0
resize < down        : yabai -m window --resize bottom:0:50
resize < shift - down  : yabai -m window --resize bottom:0:-50
resize < up          : yabai -m window --resize top:0:-50
resize < shift - up    : yabai -m window --resize top:0:50

# -----------------------------
# Service mode
# -----------------------------
:: service
alt + shift - semicolon ; service
service < escape : yabai --restart-service; skhd --restart-service; default
service < r      : yabai -m space --balance; default
service < f      : yabai -m window --toggle float; default
service < c      : yabai --restart-service; skhd --restart-service; default

# Reload configs quickly
alt + shift - c : yabai --restart-service; skhd --restart-service
