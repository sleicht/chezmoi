# Stephan's skhd config
# AeroSpace-style bindings for yabai.
# ctrl = Pop!_OS/Super-ish leader

# -----------------------------
# Focus windows
# -----------------------------
ctrl - left  : yabai -m window --focus west
ctrl - down  : yabai -m window --focus south
ctrl - up    : yabai -m window --focus north
ctrl - right : yabai -m window --focus east

# -----------------------------
# Navigate spaces
# -----------------------------
ctrl + shift - left  : yabai -m space --focus prev
ctrl + shift - right : yabai -m space --focus next
ctrl + shift - up    : yabai -m space --focus prev
ctrl + shift - down  : yabai -m space --focus next
alt - tab            : yabai -m space --focus recent

# Direct space focus
ctrl + alt - 0 : yabai -m space --focus 1
ctrl + alt - 1 : yabai -m space --focus 2
ctrl + alt - 2 : yabai -m space --focus 3
ctrl + alt - 3 : yabai -m space --focus 4
ctrl + alt - 4 : yabai -m space --focus 5
ctrl + alt - 5 : yabai -m space --focus 6
ctrl + alt - 6 : yabai -m space --focus 7
ctrl + alt - 7 : yabai -m space --focus 8

# -----------------------------
# Move / warp windows in layout
# -----------------------------
ctrl + alt - left  : yabai -m window --warp west
ctrl + alt - down  : yabai -m window --warp south
ctrl + alt - up    : yabai -m window --warp north
ctrl + alt - right : yabai -m window --warp east

# Move focused window to display
ctrl + alt + shift - left  : yabai -m window --display prev; yabai -m display --focus prev
ctrl + alt + shift - right : yabai -m window --display next; yabai -m display --focus next

# Move focused window to prev/next Space
ctrl + alt + shift - up   : yabai -m window --space prev; yabai -m space --focus prev
ctrl + alt + shift - down : yabai -m window --space next; yabai -m space --focus next

# Move window to numbered space
ctrl + shift - 0 : yabai -m window --space 1; yabai -m space --focus 1
ctrl + shift - 1 : yabai -m window --space 2; yabai -m space --focus 2
ctrl + shift - 2 : yabai -m window --space 3; yabai -m space --focus 3
ctrl + shift - 3 : yabai -m window --space 4; yabai -m space --focus 4
ctrl + shift - 4 : yabai -m window --space 5; yabai -m space --focus 5
ctrl + shift - 5 : yabai -m window --space 6; yabai -m space --focus 6
ctrl + shift - 6 : yabai -m window --space 7; yabai -m space --focus 7
ctrl + shift - 7 : yabai -m window --space 8; yabai -m space --focus 8

# -----------------------------
# Manage focused window
# -----------------------------
# Close window
ctrl - q : yabai -m window --close

# Toggle fullscreen / zoom
ctrl + alt - f   : yabai -m window --toggle zoom-fullscreen
ctrl + alt - f11 : yabai -m window --toggle native-fullscreen

# Toggle float
ctrl + alt + shift - f : yabai -m window --toggle float

# Flip / rotate / balance
ctrl + alt - o : yabai -m space --rotate 90
ctrl + alt - s : yabai -m space --layout stack
ctrl + alt - b : yabai -m space --balance

# Launch terminal
ctrl - return : open -a Ghostty

# Move current Space to next display
alt + shift - tab : yabai -m space --display next; yabai -m display --focus next

# Reload services
alt + shift - c : yabai --restart-service; skhd --restart-service

# Service-ish helpers
alt + shift - r : yabai -m rule --apply; yabai -m space --balance
alt + shift - f : yabai -m window --toggle float
alt + shift - backspace : yabai -m query --windows --space | jq '.[].id' | xargs -I{} yabai -m window {} --close

# Resize mode
:: resize @

resize < ctrl + alt - h : yabai -m window --resize left:-50:0
resize < ctrl + alt - l : yabai -m window --resize right:50:0
resize < ctrl + alt - j : yabai -m window --resize bottom:0:50
resize < ctrl + alt - k : yabai -m window --resize top:0:-50

resize < escape ; default

# Enter resize mode
ctrl + alt - r ; resize
