#!/usr/bin/env bash
# Source: gh CLI + glab CLI documentation
#MISE description="Create pull/merge request via gh/glab CLI"
#MISE dir="{{cwd}}"

set -euo pipefail

# Detect platform from origin remote
REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
if [[ "$REMOTE_URL" == *"github.com"* ]]; then
  PLATFORM="github"; CLI="gh"
elif [[ "$REMOTE_URL" == *"gitlab"* ]]; then
  PLATFORM="gitlab"; CLI="glab"
else
  echo "Cannot auto-detect platform from origin: $REMOTE_URL"
  PLATFORM=$(echo -e "github\ngitlab" | fzf --prompt="Platform: " --height=4)
  [[ -n "$PLATFORM" ]] || { echo "ERROR: No platform selected" >&2; exit 1; }
  CLI=$([[ "$PLATFORM" == "github" ]] && echo "gh" || echo "glab")
fi
echo "Detected platform: $PLATFORM (using $CLI)"

# Validate CLI auth
if ! "$CLI" auth status &>/dev/null; then
  echo "ERROR: $CLI not authenticated. Run: $CLI auth login" >&2
  exit 1
fi

# Validate not on main/master
CURRENT=$(git rev-parse --abbrev-ref HEAD)
if [[ "$CURRENT" == "main" ]] || [[ "$CURRENT" == "master" ]]; then
  echo "ERROR: Cannot create PR/MR from main/master" >&2
  exit 1
fi

# Check upstream, offer to push if missing
if ! git rev-parse @{u} &>/dev/null; then
  echo "No upstream. Push now? (Y/n):"
  read -r PUSH
  if ! [[ "$PUSH" =~ ^[Nn]$ ]]; then
    git push -u origin "$CURRENT"
  else
    echo "Cancelled. Push first: git push -u origin $CURRENT"
    exit 0
  fi
fi

# Extract or prompt for ticket (optional)
TICKET=""
if [[ "$CURRENT" =~ feature/([A-Z]+-[0-9]+) ]]; then
  TICKET="${BASH_REMATCH[1]}"
  echo "Detected ticket: $TICKET"
else
  echo "Enter Jira ticket (or Enter to skip):"
  read -r TICKET
  if [[ -n "$TICKET" ]] && ! [[ "$TICKET" =~ ^[A-Z]+-[0-9]+$ ]]; then
    echo "ERROR: Invalid format. Expected PROJECT-123 or empty" >&2
    exit 1
  fi
fi

PR_TYPE=$([[ "$PLATFORM" == "gitlab" ]] && echo "MR" || echo "PR")

# Detect main branch for diff
MAIN=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")

# Choose mode: AI or manual
MODE="manual"
if command -v claude &>/dev/null; then
  MODE=$(echo -e "ai\nmanual" | fzf --prompt="Mode: " --height=4)
  [[ -n "$MODE" ]] || MODE="manual"
fi

if [[ "$MODE" == "ai" ]]; then
  # AI-assisted: generate title and body from commits + diff
  LOG=$(git log --oneline "${MAIN}..HEAD")
  DIFF_STAT=$(git diff "${MAIN}...HEAD" --stat)

  if [[ -n "$TICKET" ]]; then
    TITLE_FORMAT="${TICKET}: <title>"
  else
    TITLE_FORMAT="<title>"
  fi

  AI_OUTPUT=$(printf "%s\n---\n%s" "$LOG" "$DIFF_STAT" | claude --print --model haiku -p \
    "Generate a $PR_TYPE title and description from these commits and diff stats.
Title format: ${TITLE_FORMAT}
Output format (exactly):
TITLE: <the title line>
BODY:
<markdown body with ## Summary (2-4 bullet points) and ## Test plan (checklist)>

Rules: title under 70 chars, imperative tense, no trailing period.
Output ONLY the formatted text, nothing else.")

  PR_TITLE=$(echo "$AI_OUTPUT" | grep "^TITLE:" | sed 's/^TITLE: //')
  PR_BODY=$(echo "$AI_OUTPUT" | sed '1,/^BODY:/d')

  # Validate title exists, fall back if not
  if [[ -z "$PR_TITLE" ]]; then
    echo "WARNING: AI output didn't match expected format, falling back to manual" >&2
    MODE="manual"
  fi
fi

if [[ "$MODE" == "manual" ]]; then
  echo "Enter $PR_TYPE title:"
  read -r TITLE
  if [[ -n "$TICKET" ]]; then
    PR_TITLE="${TICKET}: ${TITLE}"
  else
    PR_TITLE="$TITLE"
  fi

  echo "Enter description (Ctrl-D when done):"
  PR_BODY=$(cat)
fi

# Confirm
echo ""
echo "$PR_TYPE Title: $PR_TITLE"
echo "Body:"
echo "$PR_BODY"
echo ""
echo "Create $PR_TYPE? (Y/n):"
read -r CONFIRM
[[ "$CONFIRM" =~ ^[Nn]$ ]] && { echo "Cancelled"; exit 0; }

# Create via platform CLI
if [[ "$PLATFORM" == "github" ]]; then
  gh pr create --title "$PR_TITLE" --body "$PR_BODY"
else
  glab mr create --title "$PR_TITLE" --description "$PR_BODY"
fi
echo "✓ $PR_TYPE created"
