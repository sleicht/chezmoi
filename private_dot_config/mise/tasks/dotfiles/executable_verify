#!/usr/bin/env bash
#MISE description="Run configuration verification checks"
#MISE alias="v"

set -euo pipefail

SCRIPT_PATH="${HOME}/.local/share/chezmoi/scripts/verify-configs.sh"

if [[ ! -x "$SCRIPT_PATH" ]]; then
  echo "ERROR: Verification script not found: $SCRIPT_PATH" >&2
  exit 1
fi

echo "Running verification checks..."
"$SCRIPT_PATH"

echo "Done — verification complete"
