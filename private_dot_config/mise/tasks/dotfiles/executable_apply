#!/usr/bin/env bash
#MISE description="Apply dotfiles configuration"
#MISE alias="a"

set -euo pipefail

# Ensure Bitwarden session is active
if [[ -z "${BW_SESSION:-}" ]]; then
    echo "BW_SESSION not set, unlocking Bitwarden..."
    eval "$(bw-unlock)"
fi

echo "Applying dotfiles..."
chezmoi apply

echo "Done — dotfiles applied successfully"
