{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "litellm"
  ],
  "disabled_providers": [
    "opencode",
    "gitlab",
    "google-vertex",
    "google-vertex-anthropic"
  ],
  "plugin": [
    "oh-my-openagent",
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    "{{ $cc.marketplace_name.value }}@git+{{ $cc.marketplace_url_https.value }}",
{{- end }}
  ],
  "provider": {
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{{ $cc.litellm_url.value }}/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 16000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite",
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5-5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
{{- end }}
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "date *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "tr *": "allow",
      "wc *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git status *": "allow",
      "glab mr view *": "allow",
      "just *": "allow"
    },
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "websearch": "allow"
  },
  "shell": "zsh"
}