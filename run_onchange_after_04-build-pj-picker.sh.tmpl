{{- if stat (joinPath .chezmoi.sourceDir "tools/pj/main.go") -}}
#!/usr/bin/env bash
# Rebuild pj-picker when any Go build input changes.
# Source hashes (trigger rebuild on change):
{{- range $path := glob (joinPath .chezmoi.sourceDir "tools/pj/*.go") }}
# {{ base $path }}: {{ include $path | sha256sum }}
{{- end }}
{{- range $path := glob (joinPath .chezmoi.sourceDir "tools/pj/go.*") }}
# {{ base $path }}: {{ include $path | sha256sum }}
{{- end }}

set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}/tools/pj"
DEST="${HOME}/.local/bin/pj-picker"

if ! command -v go &>/dev/null; then
  echo "pj-picker: go not found; cannot build" >&2
  exit 1
fi

echo "Building pj-picker..."
mkdir -p "$(dirname "$DEST")"
tmp=$(mktemp "${DEST}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cd "$SOURCE_DIR"
go build -o "$tmp" .
chmod 0755 "$tmp"
mv -f "$tmp" "$DEST"
trap - EXIT
echo "pj-picker installed to $DEST"
{{- end }}
