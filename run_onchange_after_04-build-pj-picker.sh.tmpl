{{- if stat (joinPath .chezmoi.sourceDir "tools/pj/main.go") -}}
#!/usr/bin/env bash
# Rebuild pj-picker when Go source changes.
# Source hashes (trigger rebuild on change):
# main.go:    {{ include "tools/pj/main.go" | sha256sum }}
# scanner.go: {{ include "tools/pj/scanner.go" | sha256sum }}
# cache.go:   {{ include "tools/pj/cache.go" | sha256sum }}
# zoxide.go:  {{ include "tools/pj/zoxide.go" | sha256sum }}
# picker.go:  {{ include "tools/pj/picker.go" | sha256sum }}

set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}/tools/pj"
DEST="${HOME}/.local/bin/pj-picker"

if ! command -v go &>/dev/null; then
  echo "pj-picker: go not found, skipping build" >&2
  exit 0
fi

echo "Building pj-picker..."
mkdir -p "$(dirname "$DEST")"
cd "$SOURCE_DIR"
go build -o "$DEST" .
echo "pj-picker installed to $DEST"
{{- end }}
