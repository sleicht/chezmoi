{
{{- if eq .machine_type "client" }}
  "defaultModel": "gpt-5-5",
  "defaultProvider": "litellm",
  "defaultThinkingLevel": "low",
  "enabledModels": [
    "litellm/claude-haiku-4-5",
    "litellm/claude-sonnet-4-6",
    "litellm/claude-opus-4-6",
    "litellm/claude-opus-4-7",
    "litellm/gemini-3.5-flash",
    "litellm/gpt-5-5"
  ],
{{- else }}
  "defaultThinkingLevel": "low",
{{- end }}
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.76.0",
  "packages": [
    "npm:pi-lens@3.8.45",
    "npm:pi-mcp-adapter@2.7.0",
    "npm:@dkmnx/pi-clarify@0.1.9",
    "npm:@vanillagreen/pi-caveman@1.2.3",
    "npm:@gotgenes/pi-subagents@6.18.0",
{{- if eq .machine_type "personal" }}
    "npm:@ollama/pi-web-search",
{{- end }}
    "npm:pi-ghostty-notifier@0.1.3"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "dracula",
  "pi-ghostty-notifier": {
    "level": "medium",
    "includeSummary": true,
    "bell": "actionable"
  },
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-caveman": {
          "mode": "full"
        }
      }
    }
  }
}
