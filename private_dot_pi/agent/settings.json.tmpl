{
{{- if eq .machine_type "client" }}
  "defaultModel": "gpt-5-6-terra",
  "defaultProvider": "litellm",
  "defaultThinkingLevel": "low",
  "enabledModels": [
    "litellm/claude-haiku-5-5",
    "litellm/claude-sonnet-5=5",
    "litellm/claude-opus-5-5",
    "litellm/gemini-4-argon",
    "litellm/gpt-sol",
    "litellm/gpt-luna"
  ],
{{- else }}
  "defaultThinkingLevel": "low",
{{- end }}
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.80.6",
  "packages": [
    "npm:pi-lens@3.8.53",
    "npm:pi-mcp-adapter@2.10.0",
    "npm:@dkmnx/pi-clarify@0.1.9",
    "npm:@vanillagreen/pi-caveman@1.2.4",
    "npm:@gotgenes/pi-subagents@16.4.0",
{{- if eq .machine_type "personal" }}
    "npm:@ollama/pi-web-search",
{{- end }}
    "npm:pi-ghostty-notifier@0.1.3",
    "npm:@plannotator/pi-extension"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "dracula",
  "pi-ghostty-notifier": {
    "level": "medium",
    "includeSummary": true,
    "bell": "actionable"
  },
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-caveman": {
          "mode": "full"
        }
      }
    }
  }
{{- if eq .machine_type "personal" }}
 ,"defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol"
{{- end }}
}
