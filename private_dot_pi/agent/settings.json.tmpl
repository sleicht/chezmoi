{
{{- if eq .machine_type "client" }}
  "defaultModel": "gpt-5-5",
  "defaultProvider": "litellm",
  "defaultThinkingLevel": "low",
  "enabledModels": [
    "litellm/claude-haiku-4-5",
    "litellm/claude-sonnet-4-6",
    "litellm/claude-opus-4-6",
    "litellm/gpt-5-5"
  ],
{{- else }}
  "defaultThinkingLevel": "low",
{{- end }}
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.75.3",
  "packages": [
    "npm:pi-lens",
    "npm:pi-mcp-adapter@2.6.1",
    "npm:@dkmnx/pi-clarify",
    "npm:@vanillagreen/pi-caveman"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "dracula",
  "vstack": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-caveman": {
          "mode": "full"
        }
      }
    }
  }
}
