{
  "settings": {
    "toolPrefix": "server",
    "directTools": false
  },
  "mcpServers": {
    "intellij": {
      "url": "http://127.0.0.1:64342/stream",
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "exposeResources": true
    },
    "agent-search": {
      "command": "sh",
      "args": ["-c", "python $HOME/git/stuff/agent-search/mcp-server/server.py"]
    }
  }
}
