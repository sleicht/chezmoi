{
  "settings": {
    "toolPrefix": "server",
    "directTools": false
  },
  "mcpServers": {
    "intellij": {
      "url": "http://127.0.0.1:64343/stream"
    },
    "agent-search": {
      "command": "$HOME/.local/bin/uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "$HOME/git/stuff/agent-search/mcp-server",
        "python",
        "server.py"
      ]
    },
    "sanitas-developer-tools": {
      "url": "https://mcp.gcp.sanet17.ch/mcp"
    }
  }
}
