{{- if and (eq .machine_type "client") (eq .chezmoi.os "darwin") -}}
{{- $key := output "sh" "-c" "chezmoi secret keyring get --service=litellm --user=\"$1\" 2>/dev/null || true" "sh" .chezmoi.username | trim -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>litellm-budget-overlay</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/LiteLlmBudgetOverlay.app/Contents/MacOS/budget-overlay</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LITELLM_KEY</key>
    <string>{{ $key | html }}</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
{{- end }}
