#!/bin/bash
# Sync skills from Claude Code plugins cache and ~/.claude/skills/
# into ~/.agents/skills/ so Forge Code can discover them.
#
# Forge does not follow symlinks when scanning for skills, so we
# rsync the contents instead.  Skills removed from all sources are
# moved to ~/.agents/skills/.archive/ for manual review.
#
# Runs after every chezmoi apply.

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

FORGE_SKILLS_DIR="${HOME}/.agents/skills"
ARCHIVE_DIR="${FORGE_SKILLS_DIR}/.archive"
CLAUDE_SKILLS_DIR="${HOME}/.claude/skills"
PLUGINS_CACHE="${HOME}/.claude/plugins/cache"
INSTALLED_JSON="${HOME}/.claude/plugins/installed_plugins.json"

mkdir -p "$FORGE_SKILLS_DIR"

created=0
updated=0
skipped=0
archived=0

# Track which skill names are synced from sources (newline-separated list)
expected_skills=""

# ---------------------------------------------------------------------------
# Helper: sync a skill directory into FORGE_SKILLS_DIR
# Usage: sync_skill <skill_name> <source_dir>
# ---------------------------------------------------------------------------
sync_skill() {
  local skill_name="$1"
  local source="$2"
  local target="$FORGE_SKILLS_DIR/$skill_name"

  # Source must contain a SKILL.md
  if [[ ! -f "$source/SKILL.md" ]]; then
    return
  fi

  expected_skills="${expected_skills}${skill_name}\n"

  if [[ -d "$target" ]]; then
    # Update: rsync and check if anything changed
    if rsync -a --delete --checksum --dry-run "$source/" "$target/" 2>/dev/null | grep -q .; then
      rsync -a --delete --checksum "$source/" "$target/"
      updated=$((updated + 1))
    fi
  else
    # Create: fresh copy
    rsync -a "$source/" "$target/"
    created=$((created + 1))
  fi
}

# ---------------------------------------------------------------------------
# Phase 1: Copy skills from ~/.claude/skills/ (chezmoi-managed + others)
# ---------------------------------------------------------------------------
if [[ -d "$CLAUDE_SKILLS_DIR" ]]; then
  for skill_dir in "$CLAUDE_SKILLS_DIR"/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")

    # Resolve symlinks so rsync gets the real source
    if [[ -L "${skill_dir%/}" ]]; then
      source=$(readlink -f "${skill_dir%/}")
    else
      source="${skill_dir%/}"
    fi

    sync_skill "$skill_name" "$source"
  done
fi

# ---------------------------------------------------------------------------
# Phase 2: Copy skills from the Claude Code plugins cache
# ---------------------------------------------------------------------------
if [[ -d "$PLUGINS_CACHE" ]] && [[ -f "$INSTALLED_JSON" ]]; then
  while IFS= read -r install_path; do
    skills_root="${install_path}/skills"
    [[ -d "$skills_root" ]] || continue

    for skill_dir in "$skills_root"/*/; do
      [[ -d "$skill_dir" ]] || continue
      sync_skill "$(basename "$skill_dir")" "${skill_dir%/}"
    done
  done < <(python3 -c "
import json
with open('$INSTALLED_JSON') as f:
    data = json.load(f)
seen = set()
for entries in data.get('plugins', {}).values():
    for entry in entries:
        path = entry.get('installPath', '')
        if path and path not in seen:
            seen.add(path)
            print(path)
")
fi

# ---------------------------------------------------------------------------
# Phase 3: Archive orphaned skills no longer present in any source
# ---------------------------------------------------------------------------
for target_dir in "$FORGE_SKILLS_DIR"/*/; do
  [[ -d "$target_dir" ]] || continue
  skill_name=$(basename "$target_dir")
  if ! printf '%b' "$expected_skills" | grep -qxF "$skill_name"; then
    mkdir -p "$ARCHIVE_DIR"
    # Overwrite any previously archived version
    rm -rf "${ARCHIVE_DIR:?}/$skill_name"
    mv "$target_dir" "$ARCHIVE_DIR/$skill_name"
    archived=$((archived + 1))
  fi
done

echo "Forge skill sync: ${created} created, ${updated} updated, ${archived} archived, ${skipped} skipped"
