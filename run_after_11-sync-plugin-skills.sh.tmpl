#!/bin/bash
# Sync skills from Claude Code plugins cache and ~/.claude/skills/
# into ~/.agents/skills/ so Forge Code can discover them.
#
# Forge does not follow symlinks when scanning for skills, so we
# rsync the contents instead. Only directories created by this script are
# updated or archived; independently installed skills remain untouched.
#
# Runs after every chezmoi apply.

set -euo pipefail

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

FORGE_SKILLS_DIR="${HOME}/.agents/skills"
ARCHIVE_DIR="${FORGE_SKILLS_DIR}/.archive"
OWNERSHIP_MARKER=".chezmoi-skill-sync"
CLAUDE_SKILLS_DIR="${HOME}/.claude/skills"
PLUGINS_CACHE="${HOME}/.claude/plugins/cache"
INSTALLED_JSON="${HOME}/.claude/plugins/installed_plugins.json"

mkdir -p "$FORGE_SKILLS_DIR"

created=0
updated=0
skipped=0
archived=0

# Track which top-level entries are synced from sources (newline-separated list)
expected_entries=""
skill_names=()
skill_sources=()
shared_names=()
shared_sources=()

# ---------------------------------------------------------------------------
# Helper: register a skill source. Later sources with the same name win.
# Usage: register_skill <skill_name> <source_dir>
# ---------------------------------------------------------------------------
register_skill() {
  local skill_name="$1"
  local source="$2"
  local i

  # Source must contain a SKILL.md
  if [[ ! -f "$source/SKILL.md" ]]; then
    return
  fi

  for ((i = 0; i < ${#skill_names[@]}; i++)); do
    if [[ "${skill_names[$i]}" == "$skill_name" ]]; then
      skill_sources[i]="$source"
      return
    fi
  done

  skill_names+=("$skill_name")
  skill_sources+=("$source")
  expected_entries="${expected_entries}${skill_name}\n"
}

# ---------------------------------------------------------------------------
# Helper: register a shared resource directory. Later sources with the same name win.
# Usage: register_shared_dir <dir_name> <source_dir>
# ---------------------------------------------------------------------------
register_shared_dir() {
  local dir_name="$1"
  local source="$2"
  local i

  if [[ ! -d "$source" ]]; then
    return
  fi

  for ((i = 0; i < ${#shared_names[@]}; i++)); do
    if [[ "${shared_names[$i]}" == "$dir_name" ]]; then
      shared_sources[i]="$source"
      return
    fi
  done

  shared_names+=("$dir_name")
  shared_sources+=("$source")
  expected_entries="${expected_entries}${dir_name}\n"
}

# ---------------------------------------------------------------------------
# Helper: sync a directory into FORGE_SKILLS_DIR
# Usage: sync_dir <entry_name> <source_dir>
# ---------------------------------------------------------------------------
sync_dir() {
  local entry_name="$1"
  local source="$2"
  local target="$FORGE_SKILLS_DIR/$entry_name"
  local changes

  if [[ ! -d "$source" ]]; then
    return
  fi

  if [[ -L "$target" ]] || { [[ -e "$target" ]] && [[ ! -f "$target/$OWNERSHIP_MARKER" ]]; }; then
    echo "Skipping independently managed skill: $entry_name"
    skipped=$((skipped + 1))
    return
  fi

  if [[ -d "$target" ]]; then
    # Update: rsync and check if anything changed
    changes=$(rsync -a --delete --checksum --exclude="$OWNERSHIP_MARKER" --dry-run --itemize-changes "$source/" "$target/")
    if [[ -n "$changes" ]]; then
      rsync -a --delete --checksum --exclude="$OWNERSHIP_MARKER" "$source/" "$target/"
      updated=$((updated + 1))
    fi
  else
    # Create: fresh copy
    rsync -a "$source/" "$target/"
    touch "$target/$OWNERSHIP_MARKER"
    created=$((created + 1))
  fi
}

# ---------------------------------------------------------------------------
# Phase 1: Copy skills from ~/.claude/skills/ (chezmoi-managed + others)
# ---------------------------------------------------------------------------
if [[ -d "$CLAUDE_SKILLS_DIR" ]]; then
  for skill_dir in "$CLAUDE_SKILLS_DIR"/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")

    # Resolve symlinks so rsync gets the real source
    if [[ -L "${skill_dir%/}" ]]; then
      source=$(readlink -f "${skill_dir%/}")
    else
      source="${skill_dir%/}"
    fi

    if [[ -f "$source/SKILL.md" ]]; then
      register_skill "$skill_name" "$source"
    elif [[ "$skill_name" == _* ]]; then
      register_shared_dir "$skill_name" "$source"
    fi
  done
fi

# ---------------------------------------------------------------------------
# Phase 2: Copy skills from the Claude Code plugins cache
# ---------------------------------------------------------------------------
if [[ -d "$PLUGINS_CACHE" ]] && [[ -f "$INSTALLED_JSON" ]]; then
  install_paths=$(jq -r 'reduce (.plugins[][] | .installPath | select(. != null and . != "")) as $path ([]; if index($path) then . else . + [$path] end) | .[]' "$INSTALLED_JSON")
  while IFS= read -r install_path; do
    skills_root="${install_path}/skills"
    [[ -d "$skills_root" ]] || continue

    for skill_dir in "$skills_root"/*/; do
      [[ -d "$skill_dir" ]] || continue
      skill_name=$(basename "$skill_dir")
      source="${skill_dir%/}"

      if [[ -f "$source/SKILL.md" ]]; then
        register_skill "$skill_name" "$source"
      elif [[ "$skill_name" == _* ]]; then
        register_shared_dir "$skill_name" "$source"
      fi
    done
  done <<< "$install_paths"
fi

# ---------------------------------------------------------------------------
# Phase 3: Sync the final source selected for each top-level entry
# ---------------------------------------------------------------------------
for ((i = 0; i < ${#skill_names[@]}; i++)); do
  sync_dir "${skill_names[$i]}" "${skill_sources[$i]}"
done

for ((i = 0; i < ${#shared_names[@]}; i++)); do
  sync_dir "${shared_names[$i]}" "${shared_sources[$i]}"
done

# ---------------------------------------------------------------------------
# Phase 4: Archive orphaned top-level entries no longer present in any source
# ---------------------------------------------------------------------------
for target_dir in "$FORGE_SKILLS_DIR"/*/; do
  [[ -d "$target_dir" ]] || continue
  [[ ! -L "${target_dir%/}" && -f "$target_dir/$OWNERSHIP_MARKER" ]] || continue
  skill_name=$(basename "$target_dir")
  if ! printf '%b' "$expected_entries" | grep -qxF "$skill_name"; then
    mkdir -p "$ARCHIVE_DIR"
    archive_version=$(mktemp -d "$ARCHIVE_DIR/${skill_name}.XXXXXX")
    mv "$target_dir" "$archive_version/$skill_name"
    archived=$((archived + 1))
  fi
done

echo "Forge skill sync: ${created} created, ${updated} updated, ${archived} archived, ${skipped} skipped"
