{{- $machineType := "personal" -}}
{{- $machineType = promptString "Machine type (client/personal/server/container)" "personal" -}}

{{- $personalEmail := "" -}}
{{- if ne $machineType "container" -}}
{{-   $personalEmail = promptString "Personal email address" -}}
{{- end -}}

{{- $workEmail := "" -}}
{{- if eq $machineType "client" -}}
{{-   $workEmail = promptString "Work email address" -}}
{{- end -}}

{{- $computerName := "MacBook" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $computerName = promptString "Computer name" "MacBook" -}}
{{- end -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi "osRelease" -}}
{{-   if hasKey .chezmoi.osRelease "id" -}}
{{-     $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{-   end -}}
{{- end }}

# IDE-friendly workflow: edit in source, manually apply
edit:
  apply: false

git:
  autoCommit: false
  autoPush: false

diff:
  command: "idea"
  args:
    - "diff"
    - "{{ .Destination }}"
    - "{{ .Target }}"

merge:
  command: "idea"
  args:
    - "merge"
    - "{{ .Destination }}"
    - "{{ .Source }}"
    - "{{ .Target }}"

{{- if ne $machineType "container" }}
encryption: "age"
age:
  identity: "{{ .chezmoi.homeDir }}/.config/age/key-{{ $machineType }}.txt"
  recipient: "age1hl7puvh5w5d49qgygxpj7q7zmc9gqyutqufk2p9x55mfm7ul742qg9vjn8"
{{- end }}

data:
  machine_type: {{ $machineType | quote }}
  personal_email: {{ $personalEmail | quote }}
{{- if eq $machineType "client" }}
  work_email: {{ $workEmail | quote }}
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
  computer_name: {{ $computerName | quote }}
{{- end }}
  osid: {{ $osid | quote }}
