# -----------------------------------------------------------------------------
# 11. Development/Temporary Files (NEVER manage)
# Transient files that should never be tracked.
# -----------------------------------------------------------------------------
*.tmp
*.log
*.bak
*.swp
*~
.DS_Store
firebase-debug.log
