# =============================================================================
# .chezmoiignore — Comprehensive ignore rules for dotfiles-zsh v1.1 migration
# =============================================================================
# This file uses chezmoi template syntax (Go templates) for OS-conditional
# blocks. Patterns follow gitignore-like glob rules, relative to $HOME.
#
# Organisation: 11 sections covering the full migration lifecycle.
# Phases 8-12 will have their ignore entries REMOVED as configs are migrated.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Dotbot Infrastructure (NEVER migrate)
# These are the Dotbot symlink manager directories and scripts from the
# original dotfiles-zsh repo. They remain in the Dotbot repo only.
# -----------------------------------------------------------------------------
dotbot
dotbot/**
dotbot-asdf
dotbot-asdf/**
dotbot-brew
dotbot-brew/**
dotfiles-marketplace
dotfiles-marketplace/**
install
steps
steps/**

# -----------------------------------------------------------------------------
# 2. Repository Meta Files (NEVER deploy to $HOME)
# Repo-level documentation, CI config, and editor files that should not
# appear in the home directory.
# -----------------------------------------------------------------------------
README.md
LICENSE
LICENSE.md
AGENTS.md
AIDER.md
CLAUDE.md
.gitignore
.gitmodules
.editorconfig
.commit-message.txt
.git
.git/**
.github
.github/**
.idea
.idea/**
.planning
.planning/**
docs
docs/**
logs
logs/**
nvim
nvim/**
.docker
.docker/**
scripts
scripts/**
art
art/**
bin
bin/**
tools
tools/**

# -----------------------------------------------------------------------------
# 3. Package Management (Managed separately via brew bundle)
# Brewfiles are run manually, not deployed as dotfiles.
# -----------------------------------------------------------------------------
Brewfile
Brewfile_Client
Brewfile_Personal

# -----------------------------------------------------------------------------
# 4. System Configuration Scripts (Run manually, not deployed)
# macOS defaults script — executed once, not symlinked.
# -----------------------------------------------------------------------------
.macos

# -----------------------------------------------------------------------------
# 5. OS-Specific Exclusions (Template conditionals)
# Configs that only make sense on a particular OS.
# -----------------------------------------------------------------------------
{{- if ne .chezmoi.os "darwin" }}
# macOS-only configs — ignore on Linux
.config/aerospace
.config/aerospace/**
.config/sketchybar
.config/sketchybar/**
Library
Library/**
.finicky.js
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Generated at runtime by run_onchange_after_05-install-sketchybar-app-font.sh
.config/sketchybar/plugins
.config/sketchybar/plugins/**
.config/sketchybar/helpers/icon_map.lua
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# Linux-only configs — ignore on macOS (placeholder for future)
.config/i3
.config/i3/**
.config/sway
.config/sway/**
{{- end }}

{{- if ne .machine_type "personal" }}
# Personal-only configs — ignore on work/client machines
.claude/skills/commit-message
.claude/skills/commit-message/**
.claude/skills/gitbutler
.claude/skills/gitbutler/**
.claude/skills/glab
.claude/skills/glab/**
{{- end }}

# -----------------------------------------------------------------------------
# 6. v1.0.0 Configs (Already managed by chezmoi — NO ignore patterns needed)
# These are documented here for reference only. They are in chezmoi source
# and should NOT be ignored.
#
# Phase 2: .zshrc, .zshenv, .zprofile, .zlogin, .zsh.d/
# Phase 2: .config/git/ (.gitconfig, .gitconfig_local, .gitignore_global,
#           .gitattributes_global)
# Phase 3/5: .config/mise/
# Phase 5: .config/sheldon/
# Phase 6: .ssh/
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 7. Age Encryption Key (NEVER manage via chezmoi)
# Bootstrap key for chezmoi's age encryption — must exist before chezmoi runs.
# -----------------------------------------------------------------------------
.config/age
.config/age/**

# -----------------------------------------------------------------------------
# 8. Terminal Emulator Cache (Exclude auto-generated files)
# These files are generated by terminal emulators at runtime.
# kitty theme switching creates these when using `kitten themes`.
# ghostty state at ~/.local/state/ is outside .config (already excluded).
# wezterm has no cache in .config or $HOME.
# -----------------------------------------------------------------------------
.config/kitty/current-theme.conf
.config/kitty/dark-theme.auto.conf
.config/kitty/light-theme.auto.conf
.config/kitty/no-preference-theme.auto.conf
.config/kitty/themes
.config/kitty/themes/**

# -----------------------------------------------------------------------------
# 9. Claude Code Local State (NEVER sync)
# Only sync: settings.json, CLAUDE.md, agents/, commands/, skills/
# All else is machine-local state (history, cache, session data, plugins)
# -----------------------------------------------------------------------------

# Local settings override (machine-specific, never sync)
.claude/settings.local.json

# Cache and temporary files
.claude/cache
.claude/cache/**
.claude/debug
.claude/debug/**
.claude/downloads
.claude/downloads/**
.claude/paste-cache
.claude/paste-cache/**

# Session and runtime state
.claude/session-env
.claude/session-env/**
.claude/shell-snapshots
.claude/shell-snapshots/**
.claude/file-history
.claude/file-history/**

# Local data files
.claude/history.jsonl
.claude/__store.db
.claude/stats-cache.json
.claude/gsd-file-manifest.json

# User-generated content (local)
.claude/plans
.claude/plans/**
.claude/todos
.claude/todos/**
.claude/transcripts
.claude/transcripts/**
.claude/tasks
.claude/tasks/**

# Plugins and extensions (managed by Claude Code)
.claude/plugins
.claude/plugins/**

# System directories
.claude/statsig
.claude/statsig/**
.claude/telemetry
.claude/telemetry/**
.claude/ide
.claude/ide/**
.claude/local
.claude/local/**

# Projects directory (project-specific state)
.claude/projects
.claude/projects/**

# -----------------------------------------------------------------------------
# 10. Deprecated (Phase 12 Removal)
# Legacy tools to be cleaned up in Phase 12.
# -----------------------------------------------------------------------------
.config/nushell
.config/nushell/**
zgenom
zgenom/**
.zgenom
.config/zgenom
