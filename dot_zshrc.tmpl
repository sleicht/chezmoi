# .zshrc - managed by chezmoi
# To edit: chezmoi edit ~/.zshrc
# To apply: chezmoi apply

# === POSIX base environment ===
. "$HOME/.profile"

# === ZSH Configuration ===
typeset -U path cdpath fpath manpath

# History configuration
HISTSIZE="10000"
SAVEHIST="10000"
HISTFILE="$HOME/.zsh_history"
mkdir -p "$(dirname "$HISTFILE")"

setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# XDG directories
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"

{{- if eq .machine_type "client" }}
# === san-proxy (work network proxy) ===
if [ -f "$HOME/.bin/san-proxy.sh" ]; then
    . "$HOME/.bin/san-proxy.sh"
fi
{{- end }}

# === Plugin management (sheldon) ===
() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sheldon"
  local cache_file="$cache_dir/source.zsh"
  local lock_file="${XDG_CONFIG_HOME:-$HOME/.config}/sheldon/plugins.lock"

  if [[ ! -f "$cache_file" || "$lock_file" -nt "$cache_file" ]]; then
    mkdir -p "$cache_dir"
    sheldon source > "$cache_file"
  fi

  source "$cache_file"
}
