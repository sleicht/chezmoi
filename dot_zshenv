# .zshenv - managed by chezmoi
# To edit: chezmoi edit ~/.zshenv
# To apply: chezmoi apply
#
# This file is sourced for all shells, not just interactive ones like .zshrc.

# Startup time monitoring
zmodload zsh/datetime
ZSHRC_START_TIME=$EPOCHREALTIME

# Conditional profiling (run: ZSH_PROFILE_STARTUP=1 zsh -i -c exit)
if [[ -n "$ZSH_PROFILE_STARTUP" ]]; then
  zmodload zsh/zprof
fi

# Ensure PATH and FPATH entries are unique
typeset -U PATH path FPATH fpath

_fzf_complete_realpath () {
  # Used for `tab` completion in `shell/.completions` and `shell/.external`.
  # Can be customized to behave differently for different objects.
  local realpath="${1:--}"  # read the first arg or stdin if arg is missing

  if [ "$realpath" = '-' ]; then
    # It is a stdin, always a text content:
    local stdin="$(< /dev/stdin)"
    echo "$stdin" | bat \
      --language=sh \
      --plain \
      --color=always \
      --theme="$BAT_THEME" \
      --wrap=character \
      --terminal-width="$FZF_PREVIEW_COLUMNS" \
      --line-range :100
    return
  fi

  if [ -d "$realpath" ]; then
    eza --tree --level=2 --icons --color=always -a --ignore-glob='.DS_Store|.localized' "$realpath" | head -100
  elif [ -f "$realpath" ]; then
    mime="$(file -Lbs --mime-type "$realpath")"
    category="${mime%%/*}"
    if [ "$category" = 'image' ]; then
      # Scale to half preview width so image fits the short bottom pane
      local img_width=$(( "${FZF_PREVIEW_COLUMNS:-80}" / 2 ))
      catimg -r2 -w "$img_width" "$realpath"
    elif [[ "$mime" =~ 'binary' ]]; then
      hexyl --length 5KiB \
        --border none \
        --terminal-width "$FZF_PREVIEW_COLUMNS" \
        "$realpath"
    else
      bat --number \
        --color=always \
        --line-range :100 \
        --theme="$BAT_THEME" \
        "$realpath"
    fi
  else
    # This is not a directory and not a file, just print the string.
    echo "$realpath" | fold -w "$FZF_PREVIEW_COLUMNS"
  fi
}
