#!/bin/bash
# One-time bootstrap for pi packages that should exist globally.
# Pi manages its own updates via `pi update`; this just ensures first install.
set -euo pipefail

if ! command -v pi &> /dev/null; then
  echo "==> pi CLI not found, skipping pi package installation."
  exit 0
fi

echo "==> Checking pi packages..."

ensure_pi_package() {
  local package_name="$1"
  local package_source="$2"

  if ! pi list 2>/dev/null | grep -q "$package_name"; then
    echo "    Installing $package_source..."
    pi install "$package_source"
  else
    echo "    $package_name already installed"
  fi
}

ensure_pi_package "pi-lens" "npm:pi-lens"
ensure_pi_package "pi-mcp-adapter" "npm:pi-mcp-adapter@2.6.1"

echo "==> pi packages check complete."
