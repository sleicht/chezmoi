{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
notify = ["{{ .chezmoi.homeDir }}/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]
model = "gpt-5.6-terra"
service_tier = "fast"
model_reasoning_effort = "medium"
approvals_reviewer = "auto_review"

{{- if eq .machine_type "client" }}
model_provider = "litellm"

[model_providers.litellm]
name = "LiteLLM"
base_url = "{{ $cc.litellm_url.value }}/v1"
env_key = "OPENAI_API_KEY"
wire_api = "responses"
{{- end }}

[mcp_servers.idea]
url = "http://127.0.0.1:64342/stream"

[mcp_servers.node_repl]
args = []
command = "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "/Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "{{ .chezmoi.homeDir }}/.codex"
CODEX_HOME = "{{ .chezmoi.homeDir }}/.codex"
NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S = "2b020a2faded171bf620563ce51864b7c3ff320f1834f0044b73fcbeabb29a76,6d25aa7656feac858f3a3bdaea5bcbab0dbfd426c9de8e6931ce90c399ee8e4f"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = "Control the in-app browser in conjunction with the Browser Plugin."
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = "Control the Chrome browser in conjunction with the Chrome Plugin. Prefer this method of controlling Chrome over alternatives (such as Computer Use) unless the user explicitly mentions an alternative."
NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE = "Control desktop apps on macOS through Computer Use."
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.707.30751"
CODEX_CLI_PATH = "/Applications/ChatGPT.app/Contents/Resources/codex"

[mcp_servers.sonarqube]
command = "sonar"
args = [ "run", "mcp" ]

[mcp_servers.computer-use]
command = "./Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
args = ["mcp"]
cwd = "."
enabled = false

{{- if eq .machine_type "personal" }}
[mcp_servers.tolaria]
command = "node"
args = [ "/Applications/Tolaria.app/Contents/Resources/mcp-server/index.js" ]

[mcp_servers.tolaria.env]
VAULT_PATH = "{{ .chezmoi.homeDir }}/Documents/Getting Started"
{{- end }}

[marketplaces.openai-bundled]
last_updated = "2026-07-09T20:17:37Z"
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[features]
hooks = true
js_repl = false

[desktop]
conversationDetailMode = "STEPS_COMMANDS"
ambient-suggestions-enabled = false
followUpQueueMode = "queue"
dock-icon-preference = "codex-system"

[desktop.open-in-target-preferences]
global = "intellij"

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 2

[projects."{{ .chezmoi.homeDir }}/.local/share/chezmoi"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/jessie.ai/app-jessie"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/git/forbut"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/git/forgit"]
trust_level = "trusted"

{{- if eq .machine_type "personal" }}
[mcp_servers.gitnexus]
command = "{{ .chezmoi.homeDir }}/.npm-global/bin/gitnexus"
args = ["mcp"]

[plugins."coderabbit@openai-curated"]
enabled = true

[marketplaces.spark-codex-marketplace]
last_updated = "2026-07-11T20:21:13Z"
last_revision = "ca8783514278670223496b62148b31f51d2df17b"
source_type = "git"
source = "https://github.com/readdle/spark-codex-marketplace.git"

[plugins."spark-cli-skills@spark-codex-marketplace"]
enabled = true

[marketplaces.open-code-review]
last_updated = "2026-07-09T16:40:24Z"
last_revision = "fbc11045bde7e37fee6268119cb9949a9a3474d1"
source_type = "git"
source = "https://github.com/alibaba/open-code-review.git"
{{- end }}
