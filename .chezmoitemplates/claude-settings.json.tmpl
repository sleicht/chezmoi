{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "editorMode": "normal",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "caveman@caveman": true,
    "ck@cavekit-marketplace": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
{{- if eq .machine_type "client" }}
{{- range splitList "\n" (rbw "claude-client-config" "--folder" "dotfiles/client").notes }}
{{- if ne . "" }}
    "{{ . }}": true,
{{- end }}
{{- end }}
{{- else if eq .machine_type "personal" }}
    "aiup-compose-ktor-exposed@ai-unified-process-marketplace": true,
    "aiup-core@ai-unified-process-marketplace": true,
    "brave-search-skills@brave-search": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "git-commit-messages@dotfiles-marketplace": true,
    "gitlab-merge-requests@dotfiles-marketplace": true,
    "gitlab@claude-plugins-official": true,
    "glab-cli@dotfiles-marketplace": true,
    "jdtls-lombok@dotfiles-marketplace": true,
    "stripe@claude-plugins-official": true,
{{- end }}
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "skill-creator@claude-plugins-official": true
  },
  "env": {
{{- if eq .machine_type "client" }}
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet[1m]",
{{- else if eq .machine_type "personal" }}
    "BRAVE_SEARCH_API_KEY": "{{ (rbwFields "claude-settings" "--folder" "dotfiles/personal").brave_search_api_key.value }}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
{{- end }}
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_LSP_TOOLS": "1"
  },
  "extraKnownMarketplaces": {
    "cavekit-marketplace": {
      "source": {
        "repo": "JuliusBrussee/cavekit",
        "source": "github"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "plannotator": {
      "source": {
        "repo": "backnotprop/plannotator",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    ,
    "{{ $cc.marketplace_name.value }}": {
      "autoUpdate": true,
      "source": {
        "ref": "{{ $cc.marketplace_ref.value }}",
        "source": "git",
        "url": "{{ $cc.marketplace_url.value }}"
      }
    }
{{- else if eq .machine_type "personal" }}
    ,
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
{{- end }}
  },
  "hooks": {
    "Notification": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Waiting # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "PermissionRequest": [],
    "PostToolUse": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node \"{{ .chezmoi.homeDir }}/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "statusMessage": "Checking GitNexus index freshness...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Auto # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "PostToolUseFailure": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' ToolFail # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "PreCompact": [],
    "PreToolUse": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node \"{{ .chezmoi.homeDir }}/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "statusMessage": "Enriching with GitNexus graph context...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob|Bash"
      },
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      },
{{- end }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh'",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Read"
      }
    ],
    "SessionEnd": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Ended # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "SessionStart": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      },
{{- end }}
      {
        "hooks": [
          {
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node \"{{ .chezmoi.homeDir }}/.hindsight/coding-agents/dist/claude-sessionstart-hook.js\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"{{ .chezmoi.homeDir }}/.hindsight/coding-agents/dist/claude-stop-hook.js\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
{{- if eq .machine_type "personal" }}
      ,{
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "StopFailure": [],
    "SubagentStart": [],
    "SubagentStop": [],
    "TeammateIdle": [],
    "UserPromptSubmit": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
            "type": "command"
          }
        ]
      },
{{- end }}
      {
        "hooks": [
          {
            "command": "'{{ .chezmoi.homeDir }}/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh'",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "node \"{{ .chezmoi.homeDir }}/.hindsight/coding-agents/dist/claude-hook.js\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "sonnet",
  "outputStyle": "Explanatory",
  "permissions": {
    "allow": [
      "Bash([ -f .commit-message.txt ])",
{{- if eq .machine_type "client" }}
      "Bash([ -f .gitlab/merge_request_templates/Feature_to_Develop.md ])",
{{- end }}
      "Bash(bat:*)",
      "Bash(but *)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(fzf:*)",
      "Bash(gh api *)",
      "Bash(git *)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(just:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mvn dependency:tree:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(tr:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "mcp__ide__getDiagnostics",
      "mcp__idea__find_files_by_name_keyword",
      "mcp__idea__get_symbol_info",
      "mcp__idea__list_directory_tree",
      "mcp__idea__read_file"
{{- if eq .machine_type "client" }}
    , "mcp__sanitas-developer-tools__*"
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    , "WebFetch(domain:{{ $cc.gitlab_domain.value }})"
    , "WebFetch(domain:{{ $cc.jira_domain.value }})"
    , "WebFetch(domain:{{ $cc.wiki_domain.value }})"
{{- end }}
    ],
    "defaultMode": "auto",
    "deny": [
      "WebSearch",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /:*)",
      "Bash(sudo rm -rf /)",
      "Bash(dd if=/dev/zero of=/dev/:*)",
      "Bash(dd if=/dev/random of=/dev/:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(*:|:&*)",
      "Bash(*fork*bomb*)",
      "Bash(> /dev/sda:*)",
      "Bash(> /dev/nvme:*)",
      "Bash(> /dev/sd:*)",
      "Bash(cat /dev/urandom >:*)",
      "Bash(* | nc -l*)",
      "Bash(* | netcat -l*)",
      "Bash(* | socat*)",
      "Bash(* | base64 -d | sh*)",
      "Bash(* | base64 -d | bash*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(sudo passwd:*)",
      "Bash(passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo usermod:*)",
      "Bash(sudo groupadd:*)",
      "Bash(sudo groupdel:*)",
      "Bash(sudo adduser:*)",
      "Bash(sudo deluser:*)",
      "Bash(sudo chmod 777 /:*)",
      "Bash(sudo chown * /*)",
      "Bash(sudo rm /etc/:*)",
      "Bash(sudo rm -rf /etc/:*)",
      "Bash(sudo rm /bin/:*)",
      "Bash(sudo rm /usr/:*)",
      "Bash(sudo > /etc/:*)",
      "Bash(env | base64:*)",
      "Bash(printenv | base64:*)",
      "Bash(set | base64:*)",
      "Bash(history | grep -i password:*)",
      "Bash(history | grep -i token:*)",
      "Bash(history | grep -i secret:*)",
      "Bash(history | grep -i key:*)",
      "Bash(grep -r password /etc/:*)",
      "Bash(grep -r token /etc/:*)",
      "Bash(find / -name id_rsa:*)",
      "Bash(find / -name *.key*)",
      "Bash(find / -name *.pem*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(init 0:*)",
      "Bash(init 6:*)",
      "Bash(rm /var/log/:*)",
      "Bash(rm -rf /var/log/:*)",
      "Bash(> /var/log/:*)",
      "Bash(echo > /var/log/:*)",
      "Bash(truncate -s 0 /var/log/:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod 777 /etc/:*)",
      "Bash(chmod 777 /bin/:*)",
      "Bash(chmod 777 /usr/:*)",
      "Bash(chown -R * /*)",
      "Bash(*bitcoin-cli*)",
      "Bash(*ethereum*)",
      "Bash(*wallet.dat*)",
      "Bash(*privatekey*)",
      "Bash(find / -type f -delete:*)",
      "Bash(find / -type d -delete:*)",
      "Bash(rm -rf /home/:*)",
      "Bash(rm -rf /var/:*)",
      "Bash(rm -rf /opt/:*)"
    ]
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "permissions": {
      "additionalWritePaths": [
        "/tmp/com_gitbutler_app_si.sock",
        "{{ .chezmoi.homeDir }}/.gnupg"
      ]
    }
  },
  "statusLine": {
    "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh",
    "type": "command"
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
