#!/bin/bash
{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}
set -eufo pipefail

# bitwarden-cli (bw) has a hardcoded shebang pointing to Homebrew's node
# (#!/opt/homebrew/opt/node/bin/node), but node is managed by mise so that
# path doesn't exist. This wrapper invokes bw through PATH-resolved node,
# bypassing the broken shebang.

BW_WRAPPER="{{ .chezmoi.homeDir }}/.local/bin/bw"
BW_REAL="/opt/homebrew/bin/bw"

if [[ ! -x "$BW_REAL" ]]; then
  echo "bw not found at $BW_REAL — skipping wrapper setup"
  exit 0
fi

mkdir -p "$(dirname "$BW_WRAPPER")"

cat > "$BW_WRAPPER" << 'WRAPPER'
#!/bin/sh
exec node /opt/homebrew/bin/bw "$@"
WRAPPER

chmod +x "$BW_WRAPPER"
echo "Created bw wrapper at $BW_WRAPPER"
