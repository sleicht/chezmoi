{
  "env": {
{{- if eq .machine_type "personal" }}
    "BRAVE_SEARCH_API_KEY": "{{ (rbwFields "claude-settings" "--folder" "dotfiles/personal").brave_search_api_key.value }}"
{{- end }}
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash([ -f .commit-message.txt ])",
{{- if eq .machine_type "client" }}
      "Bash([ -f .gitlab\/merge_request_templates\/Feature_to_Develop.md ])",
{{- end }}
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(just compile:*)",
      "Bash(just generate-openapi-spec:*)",
      "Bash(just it-local:*)",
      "Bash(just recompile:*)",
      "Bash(just run:*)",
      "Bash(just test:*)",
      "Bash(just unit:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mvn dependency:tree:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(tr:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:errorprone.info)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:openapiprocessor.io)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /:*)",
      "Bash(sudo rm -rf /)",
      "Bash(dd if=/dev/zero of=/dev/:*)",
      "Bash(dd if=/dev/random of=/dev/:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(*:|:&*)",
      "Bash(*fork*bomb:*)",
      "Bash(> /dev/sda:*)",
      "Bash(> /dev/nvme:*)",
      "Bash(> /dev/sd:*)",
      "Bash(cat /dev/urandom >:*)",
      "Bash(* | nc -l:*)",
      "Bash(* | netcat -l:*)",
      "Bash(* | socat:*)",
      "Bash(* | base64 -d | sh:*)",
      "Bash(* | base64 -d | bash:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(sudo passwd:*)",
      "Bash(passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo usermod:*)",
      "Bash(sudo groupadd:*)",
      "Bash(sudo groupdel:*)",
      "Bash(sudo adduser:*)",
      "Bash(sudo deluser:*)",
      "Bash(sudo chmod 777 /:*)",
      "Bash(sudo chown * /:*)",
      "Bash(sudo rm /etc/:*)",
      "Bash(sudo rm -rf /etc/:*)",
      "Bash(sudo rm /bin/:*)",
      "Bash(sudo rm /usr/:*)",
      "Bash(sudo > /etc/:*)",
      "Bash(env | base64:*)",
      "Bash(printenv | base64:*)",
      "Bash(set | base64:*)",
      "Bash(history | grep -i password:*)",
      "Bash(history | grep -i token:*)",
      "Bash(history | grep -i secret:*)",
      "Bash(history | grep -i key:*)",
      "Bash(grep -r password /etc/:*)",
      "Bash(grep -r token /etc/:*)",
      "Bash(find / -name id_rsa:*)",
      "Bash(find / -name *.key:*)",
      "Bash(find / -name *.pem:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(init 0:*)",
      "Bash(init 6:*)",
      "Bash(rm /var/log/:*)",
      "Bash(rm -rf /var/log/:*)",
      "Bash(> /var/log/:*)",
      "Bash(echo > /var/log/:*)",
      "Bash(truncate -s 0 /var/log/:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod 777 /etc/:*)",
      "Bash(chmod 777 /bin/:*)",
      "Bash(chmod 777 /usr/:*)",
      "Bash(chown -R * /:*)",
      "Bash(*bitcoin-cli:*)",
      "Bash(*ethereum:*)",
      "Bash(*wallet.dat:*)",
      "Bash(*privatekey:*)",
      "Bash(find / -type f -delete:*)",
      "Bash(find / -type d -delete:*)",
      "Bash(rm -rf /home/:*)",
      "Bash(rm -rf /var/:*)",
      "Bash(rm -rf /opt/:*)"
    ],
    "defaultMode": "plan"
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py",
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
{{- if eq .machine_type "personal" }}
      ,{
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/stephanlv_fanaka/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
{{- end }}
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
{{- if eq .machine_type "personal" }}
      ,{
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/stephanlv_fanaka/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
{{- end }}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-island-state.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
{{- if eq .machine_type "personal" }}
    "command": "node \"/Users/stephanlv_fanaka/.claude/hooks/gsd-statusline.js\""
{{- else }}
    "command": "bash ~/.claude/statusline-command.sh"
{{- end }}
  },
  "enabledPlugins": {
    "code-review@claude-code-plugins" : true,
    "claude-code-setup@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
{{- if eq .machine_type "client" }}
    "sanitas-git-commit-messages@sanitas-llm-plugins" : true,
    "sanitas-glab-cli@sanitas-llm-plugins" : true,
    "sanitas-jdtls-lombok@sanitas-llm-plugins" : true,
    "sanitas-jira-cli@sanitas-llm-plugins" : true
{{- else if eq .machine_type "personal" }}
    "ast-grep@ast-grep-marketplace": true,
    "brave-search-skills@brave-search": true,
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "git-commit-messages@dotfiles-marketplace": true,
    "gitlab-merge-requests@dotfiles-marketplace": true,
    "glab-cli@dotfiles-marketplace": true,
    "jdtls-lombok@dotfiles-marketplace": true
{{- end }}
  },
{{- if eq .machine_type "client" }}
  "model" : "claude-opus-4-6",
{{- end }}
  "outputStyle" : "Learning",
  "extraKnownMarketplaces": {
{{- if eq .machine_type "client" }}
  "sanitas-llm-plugins" : {
    "source" : {
      "ref" : "master",
      "source" : "git",
      "url" : "git@gitlab.sanet17.ch:base\/sanitas-llm-plugins.git"
    }
  }
{{- end }}
  },
  "alwaysThinkingEnabled": true
}
