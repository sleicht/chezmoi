{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
{{- if eq .machine_type "client" }}
{{- range splitList "\n" (rbw "claude-client-config" "--folder" "dotfiles/client").notes }}
{{- if ne . "" }}
    "{{ . }}": true,
{{- end }}
{{- end }}
    "visual-explainer@visual-explainer-marketplace": true
{{- else if eq .machine_type "personal" }}
    "ast-grep@ast-grep-marketplace": true,
    "brave-search-skills@brave-search": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "git-commit-messages@dotfiles-marketplace": true,
    "gitlab-merge-requests@dotfiles-marketplace": true,
    "glab-cli@dotfiles-marketplace": true,
    "jdtls-lombok@dotfiles-marketplace": true,
    "oh-my-claudecode@omc": true
{{- end }}
  },
  "env": {
{{- if eq .machine_type "personal" }}
    "BRAVE_SEARCH_API_KEY": "{{ (rbwFields "claude-settings" "--folder" "dotfiles/personal").brave_search_api_key.value }}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
{{- end }}
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    "{{ $cc.marketplace_name.value }}": {
      "source": {
        "ref": "{{ $cc.marketplace_ref.value }}",
        "source": "git",
        "url": "{{ $cc.marketplace_url.value }}"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "repo": "nicobailon/visual-explainer",
        "source": "github"
      }
    }
{{- else if eq .machine_type "personal" }}
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
{{- end }}
    ,"worktrunk": {
      "source": {
        "repo": "max-sixty/worktrunk",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [],
    "PermissionDenied": [],
    "PermissionRequest": [],
    "PostCompact": [],
    "PostToolUse": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/gsd-context-monitor.js",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "PostToolUseFailure": [],
    "PreCompact": [],
    "PreToolUse": [],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
{{- if eq .machine_type "personal" }}
      ,{
        "hooks": [
          {
            "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/gsd-check-update.js",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "StopFailure": [],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "__claudebar_hook() { PORT=$(cat \"$HOME/.claude/claudebar-hook-port\" 2>/dev/null || echo 19847); cat | curl -s -X POST \"http://localhost:${PORT}/hook\" -H 'Content-Type: application/json' -d @- > /dev/null 2>&1 & }; __claudebar_hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": []
  },
  "includeCoAuthoredBy": false,
{{- if eq .machine_type "client" }}
  "model": "opusplan",
{{- else }}
  "model": "opusplan",
{{- end }}
  "outputStyle": "Learning",
  "permissions": {
    "allow": [
      "Bash([ -f .commit-message.txt ])",
{{- if eq .machine_type "client" }}
      "Bash([ -f .gitlab/merge_request_templates/Feature_to_Develop.md ])",
{{- end }}
      "Bash(awk:*)",
      "Bash(but commit:*)",
      "Bash(but pull:*)",
      "Bash(but stage:*)",
      "Bash(but status:*)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jira issue:*)",
      "Bash(just compile:*)",
      "Bash(just generate-openapi-spec:*)",
      "Bash(just it-local:*)",
      "Bash(just package:*)",
      "Bash(just recompile:*)",
      "Bash(just run:*)",
      "Bash(just test:*)",
      "Bash(just unit:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mvn dependency:tree:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(tr:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.sdkman.io)",
      "WebFetch(domain:app.gitbutler.com)",
      "WebFetch(domain:errorprone.info)",
      "WebFetch(domain:github.com)",
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
      "WebFetch(domain:{{ $cc.gitlab_domain.value }})",
      "WebFetch(domain:{{ $cc.jira_domain.value }})",
{{- end }}
      "WebFetch(domain:openapiprocessor.io)",
      "WebSearch",
      "mcp__ide__getDiagnostics"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /:*)",
      "Bash(sudo rm -rf /)",
      "Bash(dd if=/dev/zero of=/dev/:*)",
      "Bash(dd if=/dev/random of=/dev/:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(*:|:&*)",
      "Bash(*fork*bomb:*)",
      "Bash(> /dev/sda:*)",
      "Bash(> /dev/nvme:*)",
      "Bash(> /dev/sd:*)",
      "Bash(cat /dev/urandom >:*)",
      "Bash(* | nc -l:*)",
      "Bash(* | netcat -l:*)",
      "Bash(* | socat:*)",
      "Bash(* | base64 -d | sh:*)",
      "Bash(* | base64 -d | bash:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(sudo passwd:*)",
      "Bash(passwd:*)",
      "Bash(sudo useradd:*)",
      "Bash(sudo userdel:*)",
      "Bash(sudo usermod:*)",
      "Bash(sudo groupadd:*)",
      "Bash(sudo groupdel:*)",
      "Bash(sudo adduser:*)",
      "Bash(sudo deluser:*)",
      "Bash(sudo chmod 777 /:*)",
      "Bash(sudo chown * /:*)",
      "Bash(sudo rm /etc/:*)",
      "Bash(sudo rm -rf /etc/:*)",
      "Bash(sudo rm /bin/:*)",
      "Bash(sudo rm /usr/:*)",
      "Bash(sudo > /etc/:*)",
      "Bash(env | base64:*)",
      "Bash(printenv | base64:*)",
      "Bash(set | base64:*)",
      "Bash(history | grep -i password:*)",
      "Bash(history | grep -i token:*)",
      "Bash(history | grep -i secret:*)",
      "Bash(history | grep -i key:*)",
      "Bash(grep -r password /etc/:*)",
      "Bash(grep -r token /etc/:*)",
      "Bash(find / -name id_rsa:*)",
      "Bash(find / -name *.key:*)",
      "Bash(find / -name *.pem:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(init 0:*)",
      "Bash(init 6:*)",
      "Bash(rm /var/log/:*)",
      "Bash(rm -rf /var/log/:*)",
      "Bash(> /var/log/:*)",
      "Bash(echo > /var/log/:*)",
      "Bash(truncate -s 0 /var/log/:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(chmod 777 /etc/:*)",
      "Bash(chmod 777 /bin/:*)",
      "Bash(chmod 777 /usr/:*)",
      "Bash(chown -R * /:*)",
      "Bash(*bitcoin-cli:*)",
      "Bash(*ethereum:*)",
      "Bash(*wallet.dat:*)",
      "Bash(*privatekey:*)",
      "Bash(find / -type f -delete:*)",
      "Bash(find / -type d -delete:*)",
      "Bash(rm -rf /home/:*)",
      "Bash(rm -rf /var/:*)",
      "Bash(rm -rf /opt/:*)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "permissions": {
      "additionalWritePaths": [
        "/tmp/com_gitbutler_app_si.sock",
        "{{ .chezmoi.homeDir }}/.gnupg"
      ]
    }
  },
  "statusLine": {
{{- if eq .machine_type "personal" }}
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs",
{{- else }}
    "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh",
{{- end }}
    "type": "command"
  }
}
