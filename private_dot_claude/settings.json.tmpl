{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "caveman@caveman": true,
    "ck@cavekit-marketplace": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "fullstack-dev-skills@fullstack-dev-skills": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
{{- if eq .machine_type "client" }}
{{- range splitList "\n" (rbw "claude-client-config" "--folder" "dotfiles/client").notes }}
{{- if ne . "" }}
    "{{ . }}": true,
{{- end }}
{{- end }}
{{- else if eq .machine_type "personal" }}
    "ast-grep@ast-grep-marketplace": true,
    "brave-search-skills@brave-search": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "git-commit-messages@dotfiles-marketplace": true,
    "gitlab-merge-requests@dotfiles-marketplace": true,
    "gitlab@claude-plugins-official": true,
    "glab-cli@dotfiles-marketplace": true,
    "jdtls-lombok@dotfiles-marketplace": true,
    "oh-my-claudecode@omc": true,
    "stripe@claude-plugins-official": true,
{{- end }}
    "worktrunk@worktrunk": true
  },
  "env": {
{{- if eq .machine_type "client" }}
    "CLAUDE_CODE_USE_VERTEX": "1",
    "ANTHROPIC_VERTEX_PROJECT_ID": "{{ (rbwFields "claude-vertex-config" "--folder" "dotfiles/client").project_id.value }}",
    "CLOUD_ML_REGION": "{{ (rbwFields "claude-vertex-config" "--folder" "dotfiles/client").region.value }}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5@20251001",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6"
{{- else if eq .machine_type "personal" }}
    "BRAVE_SEARCH_API_KEY": "{{ (rbwFields "claude-settings" "--folder" "dotfiles/personal").brave_search_api_key.value }}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
{{- end }}
  },
  "extraKnownMarketplaces": {
    "cavekit-marketplace": {
      "source": {
        "repo": "JuliusBrussee/cavekit",
        "source": "github"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "fullstack-dev-skills": {
      "source": {
        "repo": "jeffallan/claude-skills",
        "source": "github"
      }
    },
    "karpathy-skills": {
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "worktrunk": {
      "source": {
        "repo": "max-sixty/worktrunk",
        "source": "github"
      }
    },
{{- if eq .machine_type "client" }}
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
    "ai-unified-process-marketplace": {
      "source": {
        "repo": "sleicht/ai-unified-marketplace",
        "source": "github"
      }
    },
    "{{ $cc.marketplace_name.value }}": {
      "source": {
        "ref": "{{ $cc.marketplace_ref.value }}",
        "source": "git",
        "url": "{{ $cc.marketplace_url.value }}"
      }
    }
{{- else if eq .machine_type "personal" }}
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
{{- end }}
  },
  "hooks": {
    "Notification": [],
    "PermissionDenied": [],
    "PermissionRequest": [],
    "PostCompact": [],
    "PostToolUse": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/gsd-context-monitor.js",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node \"/Users/stephanlv_fanaka/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "statusMessage": "Checking GitNexus index freshness...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
{{- end }}
    ],
    "PostToolUseFailure": [],
    "PreCompact": [],
    "PreToolUse": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node \"/Users/stephanlv_fanaka/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "statusMessage": "Enriching with GitNexus graph context...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob|Bash"
      }
{{- end }}
    ],
    "SessionEnd": [],
    "SessionStart": [
{{- if eq .machine_type "personal" }}
      {
        "hooks": [
          {
            "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/gsd-check-update.js",
            "type": "command"
          }
        ]
      }
{{- end }}
    ],
    "Stop": [],
    "StopFailure": [],
    "SubagentStart": [],
    "SubagentStop": [],
    "TaskCompleted": [],
    "UserPromptSubmit": []
  },
  "includeCoAuthoredBy": false,
{{- if eq .machine_type "client" }}
  "model": "opusplan",
{{- else }}
  "model": "opusplan",
{{- end }}
  "outputStyle": "Learning",
  "permissions": {
    "allow": [
      "Bash([ -f .commit-message.txt ])",
{{- if eq .machine_type "client" }}
      "Bash([ -f .gitlab/merge_request_templates/Feature_to_Develop.md ])",
{{- end }}
      "Bash(awk *)",
      "Bash(but *)",
      "Bash(cat *)",
      "Bash(confluence page get *)",
      "Bash(confluence page list *)",
      "Bash(confluence search *)",
      "Bash(confluence space list *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(git *)",
      "Bash(glab ci view *)",
      "Bash(glab issue list *)",
      "Bash(glab issue view *)",
      "Bash(glab mr diff *)",
      "Bash(glab mr list *)",
      "Bash(glab mr view *)",
      "Bash(glab pipeline list *)",
      "Bash(glab pipeline view *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jira issue list *)",
      "Bash(jira issue search *)",
      "Bash(jira issue view *)",
      "Bash(jira issue *)",
      "Bash(jira sprint list *)",
      "Bash(just compile *)",
      "Bash(just generate-openapi-spec *)",
      "Bash(just it-local *)",
      "Bash(just package *)",
      "Bash(just recompile *)",
      "Bash(just run *)",
      "Bash(just test *)",
      "Bash(just unit *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mvn dependency:tree *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(tr *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.sdkman.io)",
      "WebFetch(domain:app.gitbutler.com)",
      "WebFetch(domain:errorprone.info)",
      "WebFetch(domain:github.com)",
      "mcp__ide__getDiagnostics",
      "mcp__idea__find_files_by_name_keyword"
      "mcp__idea__get_symbol_info",
      "mcp__idea__list_directory_tree",
      "mcp__idea__read_file"
{{- if eq .machine_type "client" }}
      "mcp__sanitas-developer-tools__*",
{{- $cc := rbwFields "claude-client-config" "--folder" "dotfiles/client" }}
      "WebFetch(domain:{{ $cc.gitlab_domain.value }})",
      "WebFetch(domain:{{ $cc.jira_domain.value }})",
{{- end }}
      "WebFetch(domain:openapiprocessor.io)",
      "WebSearch"
    ],
    "defaultMode": "default",
    "deny": [
      "Bash(* | base64 -d | bash*)",
      "Bash(* | base64 -d | sh*)",
      "Bash(* | nc -l*)",
      "Bash(* | netcat -l*)",
      "Bash(* | socat*)",
      "Bash(*:|:&*)",
      "Bash(*bitcoin-cli*)",
      "Bash(*ethereum*)",
      "Bash(*fork*bomb*)",
      "Bash(*privatekey*)",
      "Bash(*wallet.dat*)",
      "Bash(> /dev/nvme*)",
      "Bash(> /dev/sd*)",
      "Bash(> /dev/sda*)",
      "Bash(> /var/log/*)",
      "Bash(cat /dev/urandom > *)",
      "Bash(chmod -R 777 /*)",
      "Bash(chmod 777 /bin/*)",
      "Bash(chmod 777 /etc/*)",
      "Bash(chmod 777 /usr/*)",
      "Bash(chown -R * /*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(dd if=/dev/random of=/dev/*)",
      "Bash(dd if=/dev/zero of=/dev/*)",
      "Bash(echo > /var/log/*)",
      "Bash(env | base64*)",
      "Bash(fdisk *)",
      "Bash(find / -name *.key*)",
      "Bash(find / -name *.pem*)",
      "Bash(find / -name id_rsa*)",
      "Bash(find / -type d -delete*)",
      "Bash(find / -type f -delete*)",
      "Bash(grep -r password /etc/*)",
      "Bash(grep -r token /etc/*)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(halt *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(history | grep -i key*)",
      "Bash(history | grep -i password*)",
      "Bash(history | grep -i secret*)",
      "Bash(history | grep -i token*)",
      "Bash(init 0*)",
      "Bash(init 6*)",
      "Bash(mkfs *)",
      "Bash(parted *)",
      "Bash(passwd *)",
      "Bash(poweroff *)",
      "Bash(printenv | base64*)",
      "Bash(reboot *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /opt/*)",
      "Bash(rm -rf /var/*)",
      "Bash(rm -rf /var/log/*)",
      "Bash(rm /var/log/*)",
      "Bash(set | base64*)",
      "Bash(shutdown *)",
      "Bash(sudo > /etc/*)",
      "Bash(sudo adduser *)",
      "Bash(sudo chmod 777 /*)",
      "Bash(sudo chown * /*)",
      "Bash(sudo deluser *)",
      "Bash(sudo groupadd *)",
      "Bash(sudo groupdel *)",
      "Bash(sudo passwd *)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf /etc/*)",
      "Bash(sudo rm /bin/*)",
      "Bash(sudo rm /etc/*)",
      "Bash(sudo rm /usr/*)",
      "Bash(sudo useradd *)",
      "Bash(sudo userdel *)",
      "Bash(sudo usermod *)",
      "Bash(truncate -s 0 /var/log/*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)"
    ]
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "permissions": {
      "additionalWritePaths": [
        "/tmp/com_gitbutler_app_si.sock",
        "{{ .chezmoi.homeDir }}/.gnupg"
      ]
    }
  },
  "statusLine": {
{{- if eq .machine_type "personal" }}
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs",
{{- else }}
    "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh",
{{- end }}
    "type": "command"
  }
}
